---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import QuickScanner from '../components/ui/QuickScanner.astro';
import CinematicCrawl from '../components/ui/CinematicCrawl.astro';
import SocialProof from '../components/sections/SocialProof.astro';
import Problem from '../components/sections/Problem.astro';
import Steps from '../components/sections/Steps.astro';
import Features from '../components/sections/Features.astro';
import Install from '../components/sections/Install.astro';
import Comparison from '../components/sections/Comparison.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { SITE, FAQ, FAQ_EXTRA } from '../data/site';

const upperCrawl = [
  'Cursor Integration',
  'Copilot PR Gate',
  'Claude Code Audit',
  'Windsurf Compatible',
  'Aider Scanner',
  '1.2s Median Scan',
  'Zero Data Exfiltration',
  '100% Local & Offline',
  '120+ AI-Specific Rules',
  'Free & MIT Licensed',
];

const lowerCrawl = [
  'Zero Hallucinations Merged',
  'Zero Secrets Leaked',
  'Diff-Speed Analysis',
  'Attribution Radar',
  'Slopsquatting Shield',
  'Pre-Commit Hook',
  'GitHub Action v1.0',
  'Free & Open Source',
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'VibeShield',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Cross-platform',
    url: SITE.url,
    license: 'https://opensource.org/licenses/MIT',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [...FAQ, ...FAQ_EXTRA].map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to scan AI-generated code before committing',
    step: [
      {
        '@type': 'HowToStep',
        name: 'Add the GitHub Action',
        text: 'Add uses: vibeshield/action@v1 to your pull_request workflow.',
      },
      {
        '@type': 'HowToStep',
        name: 'Open a pull request',
        text: 'VibeShield scans the diff and posts a VibeCheck report.',
      },
      {
        '@type': 'HowToStep',
        name: 'Merge with an audit trail',
        text: 'Accept or dismiss each finding; dismissals are logged.',
      },
    ],
  },
];
---

<BaseLayout schema={schema} canonical="/">
  <Nav slot="nav" />
  
  <Hero />

  <!-- Upper Cinematic Crawl -->
  <CinematicCrawl items={upperCrawl} direction="left" />

  <!-- Instant Value: What VibeShield does in 3 seconds -->
  <QuickScanner />

  <SocialProof />
  <Problem />
  <Steps />
  <Features />
  <Install />
  <Comparison />
  <Faq />

  <!-- Lower Cinematic Crawl -->
  <CinematicCrawl items={lowerCrawl} direction="right" />

  <FinalCta />
  <Footer slot="footer" />
</BaseLayout>
