---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import QuickScanner from '../components/ui/QuickScanner.astro';
import CinematicCrawl from '../components/ui/CinematicCrawl.astro';
import AgentPrompts from '../components/sections/AgentPrompts.astro';
import Install from '../components/sections/Install.astro';
import HowToScan from '../components/sections/HowToScan.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { SITE, FAQ } from '../data/site';

const agentTicker = [
  'Cursor Integration',
  'Claude Code Plugin',
  'Windsurf Cascade Rules',
  'GitHub Copilot Gate',
  'Aider Terminal Audit',
  'Hunt Hallucinated Packages',
  'Catch Leaked API Secrets',
  '100% Local & Offline',
  'Sub-Second Diff Scan',
  'Free & Open Source (MIT)',
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'VibeShield',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Cross-platform',
    url: SITE.url,
    license: 'https://opensource.org/licenses/MIT',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to test and bug hunt vibe-coded apps with AI agents',
    step: [
      {
        '@type': 'HowToStep',
        name: 'Copy your AI Agent Prompt or install the skill',
        text: 'Add the VibeShield rules to your .cursorrules, Claude Code plugin, or .windsurfrules.',
      },
      {
        '@type': 'HowToStep',
        name: 'Run VibeShield local audit',
        text: 'VibeShield tests your vibe-coded files for hallucinated packages, leaked keys, and component bugs.',
      },
      {
        '@type': 'HowToStep',
        name: 'Apply 1-line verified fixes',
        text: 'Review atomic diff fixes and merge safely to production with zero regressions.',
      },
    ],
  },
];
---

<BaseLayout schema={schema} canonical="/">
  <Nav slot="nav" />
  
  <!-- 1. Hero: Main Motive — Bug Hunter & Tester for AI Vibe Coding -->
  <Hero />

  <!-- 2. Ambient Ticker: High-impact agent compatibility list -->
  <CinematicCrawl items={agentTicker} direction="left" />

  <!-- 3. How It Works: Interactive Bug Hunter Demo / Simulator -->
  <div id="scanner">
    <QuickScanner />
  </div>

  <!-- 4. Agent Prompts Hub: Copy-Paste Prompts for Cursor, Claude, Windsurf, Copilot -->
  <AgentPrompts />

  <!-- 5. 3 Ways to Install Guide: One-line script, Agent Skill, NPX, or GitHub Action -->
  <Install />

  <!-- 6. How to Scan: CLI commands and workflow guide -->
  <HowToScan />

  <!-- 7. FAQ: Exactly 5 Curated Questions -->
  <Faq />

  <!-- 7. Final Action Callout -->
  <FinalCta />

  <Footer slot="footer" />
</BaseLayout>
