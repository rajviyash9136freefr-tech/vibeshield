---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import { baseHref } from '../lib/base';
---

<BaseLayout
  title="404 — Page Not Found | VibeShield"
  description="The requested page could not be found. Return to VibeShield home or browse documentation."
  canonical="/404"
  noindex={true}
>
  <Nav slot="nav" />

  <main id="main" class="relative min-h-[75vh] flex items-center justify-center py-20" style="background: var(--bg); color: var(--ink);">
    <div class="wrap text-center relative z-10 max-w-xl mx-auto px-4">
      <!-- Eyebrow Pill -->
      <div
        class="inline-flex items-center gap-2 rounded-full px-3 py-1 mb-4"
        style="border: 1px solid var(--border); background: var(--surface);"
      >
        <span class="h-2 w-2 rounded-full" style="background: var(--danger)"></span>
        <span class="eyebrow" style="color: var(--ink)">
          404 Finding · Unresolved Route
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="uppercase tracking-tight" style="color: var(--ink)">
        Route Not Found
      </h1>

      <p class="mt-3 text-base sm:text-lg leading-relaxed font-sans" style="color: var(--ink-soft)">
        The endpoint you requested does not exist or was moved.
      </p>

      <!-- Terminal Inspection Finding Card -->
      <div
        class="mt-8 text-left rounded-xl p-5 font-mono text-xs sm:text-sm"
        style="background: var(--surface); border: 1px solid var(--border); color: var(--ink);"
      >
        <div class="flex items-center justify-between pb-3 mb-3 text-xs" style="border-bottom: 1px solid var(--border); color: var(--ink-soft)">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full" style="background: color-mix(in srgb, var(--ink) 30%, transparent)"></span>
            <span class="h-2 w-2 rounded-full" style="background: color-mix(in srgb, var(--ink) 30%, transparent)"></span>
            <span class="h-2 w-2 rounded-full" style="background: color-mix(in srgb, var(--ink) 30%, transparent)"></span>
            <span class="ml-1.5 font-mono font-semibold" style="color: var(--ink)">vibeshield inspect route</span>
          </div>
          <span
            class="rounded px-2 py-0.5 font-bold"
            style="border: 1px solid var(--danger); color: var(--danger); background: color-mix(in srgb, var(--danger) 10%, var(--surface))"
          >
            HTTP 404
          </span>
        </div>

        <div class="space-y-1.5 leading-relaxed">
          <p class="font-bold">$ vibeshield inspect <span id="current-url-display" style="color: var(--ink-soft)">route</span></p>
          <div
            class="pl-3 space-y-1 mt-2 p-2 rounded-r-lg"
            style="border-left: 2px solid var(--danger); background: color-mix(in srgb, var(--danger) 6%, var(--surface))"
          >
            <p class="font-bold" style="color: var(--danger)">
              VS-ROUTE-001 &nbsp;unresolved-endpoint
            </p>
            <p style="color: var(--ink)">
              Path: <span id="current-path" class="font-bold underline">/unknown-route</span>
            </p>
            <p style="color: var(--ink-soft)">
              Status: Endpoint does not match any static routes in manifest.
            </p>
            <p class="font-semibold" style="color: var(--ok)">
              → Action: Return to home or view installation docs.
            </p>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
        <a
          href={baseHref('/')}
          class="btn-primary"
        >
          <span>← Back to Home</span>
        </a>
        <a
          href={baseHref('/#scanner')}
          class="btn-secondary"
        >
          <span>Live Demo</span>
        </a>
      </div>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<script>
  if (typeof window !== 'undefined') {
    const pathEl = document.getElementById('current-path');
    const urlEl = document.getElementById('current-url-display');
    const path = window.location.pathname || '/unknown';
    if (pathEl) pathEl.textContent = path;
    if (urlEl) urlEl.textContent = path;
  }
</script>
