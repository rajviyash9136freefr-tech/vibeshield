---
// /changelog — rendered from the repository's CHANGELOG.md at build time.
//
// This page used to be a hand-copied summary of the changelog, which meant it
// was wrong from the moment the next release shipped. It now reads the real
// file, so the site cannot disagree with the repository about what shipped.
//
// The parser is deliberately small: it understands the Keep a Changelog shape
// (## [version] — date, ### Section, - bullets with wrapped continuation
// lines) and nothing else. No markdown dependency is added for this.
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';

function changelogPath(): string {
  // `astro build` runs with cwd = site/, but fall back to the module-relative
  // path so the page still resolves if it is built from somewhere else.
  const candidates = [
    join(process.cwd(), '..', 'CHANGELOG.md'),
    join(process.cwd(), 'CHANGELOG.md'),
  ];
  return candidates.find(existsSync) ?? candidates[0];
}

interface Section {
  heading: string;
  items: string[];
}
interface Entry {
  version: string;
  date: string;
  sections: Section[];
}

/** Escape the characters that would otherwise become markup. */
function esc(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

/** A deliberately tiny inline-markdown renderer: code, bold, links. */
function inline(s: string): string {
  return esc(s)
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" rel="noopener">$1</a>');
}

function parse(raw: string): Entry[] {
  const entries: Entry[] = [];
  let entry: Entry | null = null;
  let section: Section | null = null;

  // Normalise line endings first. A Windows checkout hands us CRLF, and in
  // JavaScript `\r` is a line terminator, so `(.*)$` never matches a line that
  // ends with one — every bullet would be silently dropped.
  for (const line of raw.replace(/\r\n?/g, '\n').split('\n')) {
    const head = line.match(/^##\s+\[([^\]]+)\]\s+[—-]\s+(.+?)\s*$/);
    if (head) {
      entry = { version: head[1], date: head[2], sections: [] };
      entries.push(entry);
      section = null;
      continue;
    }
    if (!entry) continue; // the file's preamble

    const sub = line.match(/^###\s+(.+?)\s*$/);
    if (sub) {
      section = { heading: sub[1], items: [] };
      entry.sections.push(section);
      continue;
    }
    if (!section) continue;

    const bullet = line.match(/^[-*]\s+(.*)$/);
    if (bullet) {
      section.items.push(bullet[1]);
      continue;
    }
    // A wrapped continuation of the previous bullet, or a blank line between
    // bullets. Anything else (a table, a nested list) is appended as-is so it
    // still renders instead of being dropped.
    if (section.items.length && line.trim() !== '') {
      section.items[section.items.length - 1] += ' ' + line.trim();
    }
  }
  return entries;
}

const ENTRIES = parse(readFileSync(changelogPath(), 'utf8'));
const LATEST = ENTRIES[0];
---

<BaseLayout
  title="Changelog & Releases — VibeShield Security"
  description="Release notes, rule additions, and engine updates for VibeShield, the offline security scanner and bug hunter for AI vibe coding."
  canonical="/changelog"
>
  <Nav slot="nav" />
  <div class="wrap-narrow section">
    <p class="eyebrow">Changelog</p>
    <h1 class="mt-2 text-[36px] font-bold tracking-[-0.03em]">Releases</h1>
    <p class="mt-3 text-[var(--color-muted)]">
      This page is generated from
      <a class="text-[var(--color-accent)] hover:underline" href="https://github.com/rajviyash9136freefr-tech/vibeshield/blob/main/CHANGELOG.md">CHANGELOG.md</a>
      at build time, so it cannot drift from the repository. Rules are data: pack
      history lives in
      <a class="text-[var(--color-accent)] hover:underline" href="https://github.com/rajviyash9136freefr-tech/vibeshield/tree/main/rules">rules/</a>,
      binaries in
      <a class="text-[var(--color-accent)] hover:underline" href="https://github.com/rajviyash9136freefr-tech/vibeshield/releases">GitHub releases</a>.
    </p>

    {LATEST && (
      <p class="mt-4 inline-block rounded-[var(--radius-btn)] bg-[var(--color-accent-dim)] px-3 py-1.5 font-mono text-sm text-[var(--color-accent)]">
        Latest: {LATEST.version} · {LATEST.date}
      </p>
    )}

    {ENTRIES.map((e) => (
      <section class="mt-12 border-t border-[var(--color-hairline)] pt-8">
        <h2 class="font-mono text-[20px] font-semibold text-[var(--color-fg)]">
          {e.version} <span class="text-sm font-normal text-[var(--color-faint)]">· {e.date}</span>
        </h2>
        {e.sections.map((s) => (
          <div class="mt-5">
            <h3 class="text-[13px] font-semibold uppercase tracking-wide text-[var(--color-faint)]">{s.heading}</h3>
            <ul class="mt-2 list-disc space-y-2 pl-5 text-[15px] text-[var(--color-muted)]">
              {s.items.map((i) => <li set:html={inline(i)} />)}
            </ul>
          </div>
        ))}
      </section>
    ))}
  </div>
  <Footer slot="footer" />
</BaseLayout>
