---
// /changelog — powered by rule-pack + binary versions (UIUX §10 #8).
// Data lives in the repo's releases; this page mirrors the notable ones.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';

const ENTRIES = [
  {
    version: 'v2.0.0',
    date: '2026-09-18',
    title: 'The terminal workspace',
    items: [
      '`--format sarif` — SARIF 2.1.0 output for GitHub code scanning, so findings land in your repository\'s Security tab via `github/codeql-action/upload-sarif`, with the rule text, the one-line fix and a stable fingerprint.',
      '`-v` / `--verbose` on `scan` and `fix` — reports the resolved config, mode, languages, pack version and walk result.',
      '`vibeshield init` — detects the stack from your manifests and writes a `vibeshield.yml`, a pull-request gate workflow and a POSIX pre-commit hook, then runs the first scan. Never overwrites a file without `--force`, never touches an existing git hook.',
      'Interactive console — running `vibeshield` with no arguments opens a searchable, keyboard-driven menu over every action, rule and agent recipe. Arrow keys, Tab to jump groups, Enter to open.',
      '`vibeshield search [query]` — the same ranking on stdout, with `--list`, `--rules`, `--agents`, `--limit` and `--format json` (`vibeshield.search/v1`) for scripts and agent tool-calls.',
      '`vibeshield agents [name]` — setup recipes for Codex, Claude Code (CLI and Desktop), Google Antigravity, Cursor, Windsurf, GitHub Copilot and any `AGENTS.md` client, with `--body` and `--markdown`.',
      'Agent rule files generated from one source of truth, with CI failing on drift: `AGENTS.md`, `.agents/rules/`, `.cursor/rules/`, `.cursorrules`, `.windsurf/rules/`, `.windsurfrules`, `.github/copilot-instructions.md`.',
      'The GitHub Action now verifies the downloaded scanner against the release `sha256sums.txt` before executing it.',
      'Core rules pack v2.0.0 (MIT): 122 rules across 6 categories. Rule IDs and semantics unchanged.',
    ],
  },
  {
    version: 'v1.0.0',
    date: '2026-09-13',
    title: 'Launch',
    items: [
      'GitHub Action (`vibeshield/action@v1`) — diff-mode PR scans, consolidated VibeCheck report, accept/dismiss commands, badge.',
      'Pre-commit hook — staged-files scan, fully offline rules.',
      'CLI — `scan | fix | version`, `--format pretty|json|github`.',
      'Core rules pack v1.0.0 (MIT): 122 rules across the AI-code failure modes, 11 languages.',
      'Bug-hunting skill (`/vibeshield:vibeshield-audit`) — in-agent audit with parallel hunter subagents, same finding contract.',
    ],
  },
];
---

<BaseLayout
  title="Changelog — VibeShield"
  description="VibeShield releases: scanner, rule packs, and the bug-hunting skill. Every rules-pack version is diffable in the open-source repo."
  canonical="/changelog"
>
  <Nav slot="nav" />
  <div class="wrap-narrow section">
    <p class="eyebrow">Changelog</p>
    <h1 class="mt-2 text-[36px] font-bold tracking-[-0.03em]">Releases</h1>
    <p class="mt-3 text-[var(--color-muted)]">
      Rules are data: pack history lives in
      <a class="text-[var(--color-accent)] hover:underline" href="https://github.com/rajviyash9136freefr-tech/vibeshield/tree/main/rules">rules/ in the repo</a>.
      Binary history in
      <a class="text-[var(--color-accent)] hover:underline" href="https://github.com/rajviyash9136freefr-tech/vibeshield/releases">GitHub releases</a>.
    </p>
    {ENTRIES.map((e) => (
      <section class="mt-12 border-t border-[var(--color-hairline)] pt-8">
        <h2 class="font-mono text-[20px] font-semibold text-[var(--color-fg)]">{e.version} <span class="text-sm font-normal text-[var(--color-faint)]">· {e.date} · {e.title}</span></h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-[15px] text-[var(--color-muted)]">
          {e.items.map((i) => <li>{i}</li>)}
        </ul>
      </section>
    ))}
  </div>
  <Footer slot="footer" />
</BaseLayout>
