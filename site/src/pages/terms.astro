---
import LegalLayout from '../layouts/LegalLayout.astro';
import { siteConfig } from '../config/site';

const title = "Terms of Service — VibeShield";
const description = "Terms of service and MIT license terms for VibeShield: open source usage rights, warranty disclaimers, liability limitations, and governing law.";

const mitText = `Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all
copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE.`;
---

<LegalLayout
  title={title}
  description={description}
  canonical="/terms"
  eyebrow="Terms of Use & License"
  h1="Terms of Service"
  updated={siteConfig.legalLastUpdated}
  summary="VibeShield is free and open-source software distributed under the permissive MIT License. You can run, fork, and inspect code on any personal or commercial project without cost. The software is provided 'AS IS' with no warranty and no liability for missed findings or false positives."
>
  <section id="agreement">
    <h2>1. Agreement to Terms</h2>
    <p>
      These Terms of Service ("Terms") constitute a legally binding agreement between you ("User", "you", or "your") and <strong>{siteConfig.legalName}</strong> ("VibeShield", "we", "us", or "our"), governing your access to and use of the VibeShield static analysis CLI, GitHub Action, npm packages, rulesets, and documentation website located at <code>{siteConfig.siteUrl}</code>.
    </p>
    <p>
      By downloading, compiling, installing, running, or accessing VibeShield, you acknowledge that you have read, understood, and agree to be bound by these Terms and the MIT License.
    </p>
  </section>

  <section id="service-description">
    <h2>2. Description of Service</h2>
    <p>
      VibeShield is a developer security utility providing offline static code analysis designed to inspect AI-generated code, configuration files, and package manifests for common security risks, including hallucinated dependency names (slopsquatting), hardcoded secrets, and insecure default configurations.
    </p>
  </section>

  <section id="license-rights">
    <h2>3. Open Source License & Intellectual Property</h2>
    <p>
      The core source code, binaries, rulesets, and documentation of VibeShield are released under the terms of the <strong>MIT License</strong>.
    </p>
    <ul>
      <li><strong>Your Code Ownership:</strong> You retain 100% intellectual property ownership of any source code, repositories, commits, and scan output processed by VibeShield. We claim zero ownership or rights over your code.</li>
      <li><strong>Permitted Uses:</strong> Subject to the MIT License, you are permitted to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the software in personal, commercial, educational, or closed-source enterprise projects.</li>
      <li><strong>Notice Requirement:</strong> The copyright notice and license text reproduced below must be retained in any substantial portions of the software redistribution.</li>
    </ul>
  </section>

  <section id="acceptable-use">
    <h2>4. Acceptable Use</h2>
    <p>You agree to use VibeShield only for lawful purposes. You shall not:</p>
    <ul>
      <li>Use VibeShield to intentionally conduct malicious cyber activities, distribute trojans or malware, or violate applicable local, national, or international laws.</li>
      <li>Falsely state or imply that the maintainers or contributors of VibeShield endorse, sponsor, or guarantee your software applications or security posture.</li>
      <li>Misrepresent the findings or certification status of software scanned with VibeShield.</li>
    </ul>
  </section>

  <section id="accounts">
    <h2>5. User Accounts & Payments</h2>
    <p>
      VibeShield requires <strong>no user registration, accounts, passwords, or subscriptions</strong>. The tool is free of charge. There are no paid tiers, enterprise subscriptions, or payment processing gateways associated with the project.
    </p>
  </section>

  <section id="no-guarantee">
    <h2>6. Security Disclaimer: No Guarantee of Completeness</h2>
    <p>
      <strong>A clean VibeShield scan is NOT a guarantee of complete security or flawless code.</strong>
    </p>
    <p>
      Static analysis is inherently heuristic and pattern-based. VibeShield checks code against a curated set of rules targeting known vulnerability patterns and AI hallucination failure modes. It cannot detect zero-day exploits, novel attack vectors, complex logical flaws outside its rule pack, or runtime vulnerabilities.
    </p>
    <p>
      VibeShield is intended as an automated advisory aid. It is never a substitute for comprehensive manual code audits, penetration testing, architectural review, or human developer diligence.
    </p>
  </section>

  <section id="warranty-disclaimer">
    <h2>7. Disclaimer of Warranties</h2>
    <p>
      THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND NONINFRINGEMENT.
    </p>
    <p>
      NEITHER VIBESHIELD NOR ITS CONTRIBUTORS WARRANT THAT THE OPERATION OF THE SCANNER WILL BE UNINTERRUPTED, ERROR-FREE, ACCURATE, OR COMPATIBLE WITH ALL PLATFORMS, COMPILERS, OR CODING AGENTS.
    </p>
  </section>

  <section id="limitation-liability">
    <h2>8. Limitation of Liability</h2>
    <p>
      TO THE MAXIMUM EXTENT PERMITTED BY APPLICABLE LAW, IN NO EVENT SHALL THE AUTHORS, MAINTAINERS, OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES, OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT, OR OTHERWISE, ARISING FROM, OUT OF, OR IN CONNECTION WITH THE SOFTWARE, OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
    </p>
    <p>
      THIS INCLUDES, WITHOUT LIMITATION, DAMAGES FOR LOST PROFITS, DATA LOSS, COMPROMISED SYSTEMS, CI/CD DELAYS, MISSED SECURITY VULNERABILITIES, OR FALSE-POSITIVE BLOCKERS.
    </p>
  </section>

  <section id="termination">
    <h2>9. Termination</h2>
    <p>
      You may terminate this agreement at any time simply by discontinuing all use of VibeShield and removing the software from your systems. As an offline open-source tool, your rights under the MIT License remain in effect in accordance with the license conditions.
    </p>
  </section>

  <section id="governing-law">
    <h2>10. Governing Law & Dispute Resolution</h2>
    <p>
      These Terms and any disputes arising out of or related to your use of the website or software shall be governed by and construed in accordance with the <strong>{siteConfig.governingLaw}</strong>, without giving effect to any principles of conflicts of law.
    </p>
  </section>

  <section id="modifications">
    <h2>11. Modifications to Terms</h2>
    <p>
      We reserve the right to revise these Terms at any time by updating this webpage. The "Last updated" date at the top reflects the most recent revision. Your continued use of the website or tools following the posting of changes constitutes your acceptance of such changes.
    </p>
  </section>

  <section id="mit-license-text">
    <h2>12. Full MIT License Text</h2>
    <pre><code>MIT License

Copyright (c) 2026 {siteConfig.legalName}

{mitText}</code></pre>
  </section>

  <section id="contact">
    <h2>13. Contact Information</h2>
    <p>
      If you have questions regarding these Terms or licensing, please reach out via:
    </p>
    <ul>
      <li><strong>Email:</strong> <code>{siteConfig.contactEmail}</code></li>
      <li><strong>Repository Issues:</strong> <a href={siteConfig.social.issues} target="_blank" rel="noopener noreferrer">{siteConfig.social.issues}</a></li>
      <li><strong>Address:</strong> {siteConfig.address}</li>
    </ul>
  </section>
</LegalLayout>
