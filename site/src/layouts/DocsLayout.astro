---
interface Props {
  title: string;
  description: string;
  /** Current doc slug for the sidebar active state, if a docs page. */
  docSlug?: string;
  /** JSON-LD graphs to embed (e.g. HowTo on the quickstart). */
  schema?: object[];
}
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import { SITE } from '../data/site';

const { title, description, docSlug, schema: extraSchema = [] } = Astro.props;

const DOCS = [
  ['quickstart', 'Quickstart'],
  ['github-action', 'GitHub Action'],
  ['pre-commit', 'Pre-commit hook'],
  ['cli', 'CLI reference'],
  ['config', 'Configuration'],
  ['rules', 'Rules & detection'],
  ['skill', 'Bug-hunting skill'],
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'VibeShield',
    url: SITE.url,
    logo: `${SITE.url}/shield.svg`,
    sameAs: [SITE.repo],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Docs', item: `${SITE.url}/docs` },
      { '@type': 'ListItem', position: 2, name: title, item: Astro.url.href },
    ],
  },
  ...extraSchema,
];
---

<BaseLayout title={`${title} — VibeShield docs`} description={description} schema={schema}>
  <Nav slot="nav" />
  <div class="wrap grid gap-10 py-16 lg:grid-cols-[220px_minmax(0,1fr)]">
    <aside>
      <nav aria-label="Docs" class="lg:sticky lg:top-24">
        <p class="text-sm font-semibold text-[var(--color-fg)]">Docs</p>
        <ul class="mt-3 space-y-1">
          {DOCS.map(([slug, label]) => (
            <li>
              <a
                href={`/docs/${slug}`}
                aria-current={slug === docSlug ? 'page' : undefined}
                class={`block rounded-[var(--radius-btn)] px-3 py-1.5 text-sm ${
                  slug === docSlug
                    ? 'bg-[var(--color-accent-dim)] text-[var(--color-accent)]'
                    : 'text-[var(--color-muted)] hover:bg-[var(--color-hovered)] hover:text-[var(--color-fg)]'
                }`}
              >{label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
    <article class="wrap-narrow !max-w-[760px] !px-0 prose-docs">
      <slot />
    </article>
  </div>
  <Footer slot="footer" />
</BaseLayout>
