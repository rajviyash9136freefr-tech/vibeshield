---
import { NAV, SITE } from '../../data/site';
import { baseHref } from '../../lib/base';
---

<header id="top" class="fixed top-0 left-0 right-0 z-50 px-4 pt-3.5 pb-2 transition-all duration-200">
  <div class="wrap !p-0">
    <nav
      class="mx-auto flex h-14 items-center justify-between rounded-full px-5 transition-all duration-200 sm:px-6"
      style="background: var(--bg); border: 1px solid var(--border);"
      aria-label="Main navigation"
    >
      <!-- Logo -->
      <a href={baseHref('/')} class="group flex items-center gap-2.5 font-bold tracking-tight text-sm font-display" style="color: var(--ink)">
        <div class="flex h-7 w-7 items-center justify-center rounded-full" style="background: var(--ink); color: var(--on-ink)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 2 4 5.5V11c0 5 3.2 8.9 8 10.5 4.8-1.6 8-5.5 8-10.5V5.5L12 2Z"
              stroke="currentColor"
              stroke-width="2"
              fill="none"
            />
            <path
              d="m8.5 11.8 2.4 2.4 4.6-4.9"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>
        <span class="tracking-wider uppercase font-extrabold text-[14px]">VibeShield</span>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden items-center gap-7 md:flex">
        {NAV.map((n) => (
          <a
            href={baseHref(n.href)}
            class="text-sm font-semibold transition-colors duration-150"
            style="color: var(--ink-soft)"
            onmouseover="this.style.color='var(--ink)'"
            onmouseout="this.style.color='var(--ink-soft)'"
          >
            {n.label}
          </a>
        ))}
      </div>

      <!-- Action Pill Group -->
      <div class="hidden items-center gap-3 md:flex">
        <a
          href={SITE.repo}
          class="flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold transition-colors duration-150"
          style="border: 1px solid var(--border); background: var(--surface); color: var(--ink)"
          aria-label="VibeShield on GitHub"
          target="_blank"
          rel="noreferrer"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A7.995 7.995 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          <span>Star</span>
          <span class="rounded px-1.5 py-0.5 text-[10px] font-mono" style="background: color-mix(in srgb, var(--ink) 10%, transparent)">v0.3.0</span>
        </a>
        <a
          href={baseHref('/#install')}
          class="btn-primary"
          style="padding: 7px 16px; font-size: 13px"
        >
          Install Free
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="nav-toggle"
        class="md:hidden flex h-8 w-8 items-center justify-center rounded-full transition-colors"
        style="border: 1px solid var(--border); background: var(--surface); color: var(--ink)"
        aria-expanded="false"
        aria-controls="mobile-sheet"
        aria-label="Open menu"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"/>
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-sheet" class="fixed inset-0 z-50 hidden flex-col md:hidden" style="background: var(--bg)">
    <div class="flex h-16 items-center justify-between px-6" style="border-bottom: 1px solid var(--border)">
      <span class="font-bold font-display uppercase tracking-wider" style="color: var(--ink)">VibeShield</span>
      <button id="nav-close" class="flex h-8 w-8 items-center justify-center rounded-full" style="border: 1px solid var(--border); background: var(--surface); color: var(--ink)" aria-label="Close menu">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <div class="flex flex-1 flex-col gap-2 px-6 pt-6">
      {NAV.map((n) => (
        <a href={baseHref(n.href)} class="mobile-link rounded-xl px-4 py-3 text-lg font-semibold transition-colors" style="color: var(--ink)">
          {n.label}
        </a>
      ))}
    </div>
    <div class="p-6" style="border-top: 1px solid var(--border)">
      <a href={baseHref('/#install')} class="mobile-link btn-primary w-full text-center">
        Install Free
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const sheet = document.getElementById('mobile-sheet');
  const close = document.getElementById('nav-close');
  const setOpen = (open: boolean) => {
    sheet!.classList.toggle('hidden', !open);
    sheet!.classList.toggle('flex', open);
    toggle!.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  sheet?.querySelectorAll('.mobile-link').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
