---
import { NAV, SITE } from '../../data/site';
import { baseHref } from '../../lib/base';

const year = new Date().getFullYear();
---

<header
  id="top"
  class="sticky top-0 z-50 border-b border-[var(--color-hairline)] backdrop-blur-[12px]"
  style="background: rgba(10,10,11,0.8);"
>
  <nav class="wrap flex h-16 items-center justify-between gap-4" aria-label="Main">
    <a href={baseHref('/')} class="flex items-center gap-2 font-semibold tracking-tight text-[17px]">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 2 4 5.5V11c0 5 3.2 8.9 8 10.5 4.8-1.6 8-5.5 8-10.5V5.5L12 2Z"
          stroke="var(--color-accent)" stroke-width="1.8" fill="var(--color-accent-dim)" />
        <path d="m8.5 11.8 2.4 2.4 4.6-4.9" stroke="var(--color-accent)" stroke-width="1.8"
          stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      VibeShield
    </a>

    <div class="hidden items-center gap-6 md:flex">
      {NAV.map((n) => (
        <a href={baseHref(n.href)} class="text-sm text-[var(--color-muted)] transition-colors duration-150 hover:text-[var(--color-fg)]">
          {n.label}
        </a>
      ))}
    </div>

    <div class="hidden items-center gap-3 md:flex">
      <a
        href={SITE.repo}
        class="flex items-center gap-1.5 rounded-full border border-[var(--color-hairline)] px-3 py-1 text-sm text-[var(--color-muted)] transition-colors duration-150 hover:border-[var(--color-accent)] hover:text-[var(--color-fg)]"
        aria-label="VibeShield on GitHub"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A7.995 7.995 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        <img
          src="https://img.shields.io/github/stars/rajviyash9136freefr-tech/vibeshield?style=flat-square&labelColor=111113&color=2DD4BF"
          alt="GitHub stars"
          width="52" height="18" class="rounded" loading="lazy"
        />
      </a>
      <a href={SITE.repo} class="text-sm text-[var(--color-muted)] transition-colors duration-150 hover:text-[var(--color-fg)]">Open source</a>
      <a
        href={baseHref('/#install')}
        class="rounded-[var(--radius-btn)] bg-[var(--color-accent-strong)] px-4 py-2 text-sm font-semibold text-[#06231f] transition-transform duration-150 hover:-translate-y-px"
      >Install free</a>
    </div>

    <button
      id="nav-toggle"
      class="md:hidden rounded-[var(--radius-btn)] border border-[var(--color-hairline)] p-2"
      aria-expanded="false"
      aria-controls="mobile-sheet"
      aria-label="Open menu"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"/></svg>
    </button>
  </nav>

  <div id="mobile-sheet" class="fixed inset-0 z-50 hidden flex-col bg-[var(--color-bg)] md:hidden">
    <div class="flex h-16 items-center justify-between px-6">
      <span class="font-semibold">VibeShield</span>
      <button id="nav-close" class="rounded-[var(--radius-btn)] border border-[var(--color-hairline)] p-2" aria-label="Close menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div class="flex flex-1 flex-col gap-1 px-6 pt-4">
      {NAV.map((n) => (
        <a href={baseHref(n.href)} class="mobile-link rounded-[var(--radius-btn)] px-3 py-3 text-lg text-[var(--color-fg)] hover:bg-[var(--color-hovered)]">
          {n.label}
        </a>
      ))}
    </div>
    <div class="p-6">
      <a href={baseHref('/#install')} class="mobile-link block rounded-[var(--radius-btn)] bg-[var(--color-accent-strong)] px-4 py-3 text-center font-semibold text-[#06231f]">
        Install free
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const sheet = document.getElementById('mobile-sheet');
  const close = document.getElementById('nav-close');
  const setOpen = (open: boolean) => {
    sheet!.classList.toggle('hidden', !open);
    sheet!.classList.toggle('flex', open);
    toggle!.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  sheet?.querySelectorAll('.mobile-link').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
