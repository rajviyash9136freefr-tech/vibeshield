---
/**
 * Apple Pro Code Block with copy pill + obsidian glass surface.
 */
interface Props {
  code: string;
  filename?: string;
  label?: string;
  class?: string;
}
const { code, filename, label, class: cls = '' } = Astro.props;
---

<div class={`relative ${cls}`}>
  {filename && (
    <div class="mb-[-1px] inline-block rounded-t-xl border border-b-0 border-white/15 bg-white/5 px-3 py-1 font-mono text-xs text-white/60">
      {filename}
    </div>
  )}
  <pre
    class="scroll-x fade-x rounded-2xl border border-white/10 bg-black/60 p-4 font-mono text-[13px] leading-[1.7] text-white/85"
    tabindex="0"
    data-code
  ><code set:html={code.replace(/&/g, '&amp;').replace(/</g, '&lt;')} /></pre>
  <button
    type="button"
    class="absolute top-3 right-3 rounded-full border border-white/20 bg-white/10 px-2.5 py-1 text-[11px] font-mono text-white/70 transition-all duration-200 hover:border-white hover:bg-white hover:text-black active:scale-95"
    aria-label={label ?? 'Copy code to clipboard'}
    data-copy
  >Copy</button>
</div>
