---
interface Props {
  items: string[];
  class?: string;
}

const {
  items,
  class: cls = '',
} = Astro.props;
---

<div
  class={`py-4 select-none ${cls}`}
  style="background: var(--surface); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);"
>
  <div class="wrap flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-xs font-display">
    <span class="eyebrow mr-2" style="color: var(--ink)">
      Engine Compatibility:
    </span>
    {items.slice(0, 7).map((item) => (
      <span
        class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-bold text-[11px] uppercase tracking-wider"
        style="border: 1px solid var(--border); background: var(--bg); color: var(--ink);"
      >
        <span class="h-1.5 w-1.5 rounded-full" style="background: var(--ink)"></span>
        {item}
      </span>
    ))}
  </div>
</div>
