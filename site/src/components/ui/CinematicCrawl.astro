---
interface Props {
  items: string[];
  direction?: 'left' | 'right';
  speed?: 'normal' | 'fast';
  class?: string;
}

const {
  items,
  direction = 'left',
  speed = 'normal',
  class: cls = '',
} = Astro.props;

// Duplicate array for guaranteed content density across ultra-wide monitors
const trackItems = [...items, ...items];
---

<div
  class={`relative overflow-hidden border-y border-white/10 bg-[#050507] py-3.5 font-mono text-xs tracking-wider text-white/70 select-none ${cls}`}
  data-cinematic-crawl
  data-direction={direction}
>
  <!-- Edge gradient masks for smooth cinematic fade -->
  <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-black to-transparent" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-black to-transparent" aria-hidden="true"></div>

  <div class="crawl-wrapper flex w-max overflow-hidden">
    <!-- First track group -->
    <div class={`crawl-track flex shrink-0 items-center gap-8 pr-8 ${direction === 'left' ? 'animate-crawl-left' : 'animate-crawl-right'}`}>
      {trackItems.map((item) => (
        <div class="flex items-center gap-6 whitespace-nowrap">
          <span class="text-white/75 hover:text-white transition-colors duration-200">{item}</span>
          <span class="text-white/20 text-[10px]">◆</span>
        </div>
      ))}
    </div>
    <!-- Identical clone track group for 100% seamless infinite loop without stutter -->
    <div class={`crawl-track flex shrink-0 items-center gap-8 pr-8 ${direction === 'left' ? 'animate-crawl-left' : 'animate-crawl-right'}`} aria-hidden="true">
      {trackItems.map((item) => (
        <div class="flex items-center gap-6 whitespace-nowrap">
          <span class="text-white/75 hover:text-white transition-colors duration-200">{item}</span>
          <span class="text-white/20 text-[10px]">◆</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  @keyframes crawlLeft {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-100%, 0, 0);
    }
  }

  @keyframes crawlRight {
    0% {
      transform: translate3d(-100%, 0, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  .animate-crawl-left {
    animation: crawlLeft 22s linear infinite;
    will-change: transform;
  }

  .animate-crawl-right {
    animation: crawlRight 22s linear infinite;
    will-change: transform;
  }

  /* Keep running continuously with graceful slight slow-down on hover instead of jarring pause */
  [data-cinematic-crawl]:hover .crawl-track {
    animation-play-state: running;
    filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.3));
  }
</style>

