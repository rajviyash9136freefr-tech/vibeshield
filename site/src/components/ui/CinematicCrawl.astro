---
interface Props {
  items: string[];
  class?: string;
}

const {
  items,
  class: cls = '',
} = Astro.props;
---

<div class={`border-y border-[rgba(71,76,128,0.15)] bg-[#faf9f0] py-4 select-none ${cls}`}>
  <div class="wrap flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-xs font-display">
    <span class="font-extrabold uppercase tracking-widest text-[#474c80] text-[11px] mr-2">
      Engine Compatibility:
    </span>
    {items.slice(0, 7).map((item) => (
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[rgba(71,76,128,0.18)] bg-white px-3 py-1 font-bold text-[#474c80] text-[11px] uppercase tracking-wider shadow-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-[#474c80]"></span>
        {item}
      </span>
    ))}
  </div>
</div>
