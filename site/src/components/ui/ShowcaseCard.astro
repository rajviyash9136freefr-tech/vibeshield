---
/**
 * Flagship Apple Pro Inspector Showcase Card ("The Best Card")
 * Pure two-color obsidian/titanium aesthetic, 3D gyroscopic tilt,
 * interactive segmented mode controller, and live audit simulation.
 */
---

<div
  class="relative mx-auto w-full max-w-5xl rounded-[28px] border border-[rgba(248,247,226,0.18)] bg-gradient-to-b from-[#262b4e] to-[#171a2e] p-6 shadow-[0_25px_60px_-15px_rgba(19,22,39,0.95),0_0_40px_rgba(71,76,128,0.25)] backdrop-blur-3xl sm:p-8 lg:p-10"
  data-tilt="4"
  id="pro-inspector-card"
>
  <!-- Ambient specular edge glow inside card -->
  <div class="pointer-events-none absolute inset-0 rounded-[28px] bg-[radial-gradient(ellipse_at_top,rgba(248,247,226,0.08),transparent_60%)]" aria-hidden="true"></div>

  <!-- Top Hardware Status Bar -->
  <div class="relative z-10 flex flex-wrap items-center justify-between gap-4 border-b border-[rgba(248,247,226,0.12)] pb-5">
    <div class="flex items-center gap-3">
      <span class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#f8f7e2] opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#f8f7e2]"></span>
      </span>
      <span class="font-display text-xs font-bold tracking-wider text-[#f8f7e2] uppercase">
        VibeShield Pro Inspector
      </span>
      <span class="hidden rounded-full border border-[rgba(248,247,226,0.15)] px-2.5 py-0.5 text-xs font-mono text-[#f8f7e2]/50 sm:inline-block">
        v3.0
      </span>
    </div>

    <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
      <span class="flex items-center gap-1.5 rounded-full border border-[rgba(248,247,226,0.2)] bg-[rgba(248,247,226,0.08)] px-3 py-1 text-[#f8f7e2] font-semibold shadow-sm">
        <svg class="h-3.5 w-3.5 text-[#f8f7e2]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <span>1.2s Median</span>
      </span>
      <span class="rounded-full border border-[rgba(248,247,226,0.2)] bg-[rgba(248,247,226,0.08)] px-3 py-1 text-[#f8f7e2] font-semibold">
        0 Data Exfil
      </span>
      <span class="rounded-full border border-[rgba(248,247,226,0.3)] bg-[#f8f7e2] text-[#474c80] px-3 py-1 font-bold">
        100% Local
      </span>
    </div>
  </div>

  <!-- Segmented Mode Controller -->
  <div class="relative z-10 mt-6 flex flex-wrap items-center justify-between gap-4">
    <div class="inline-flex rounded-full border border-[rgba(248,247,226,0.18)] bg-[rgba(248,247,226,0.06)] p-1 backdrop-blur-xl" role="tablist" aria-label="Inspector Mode">
      <button
        type="button"
        role="tab"
        id="mode-slop"
        aria-selected="true"
        data-inspector-tab="slop"
        class="inspector-tab rounded-full px-4 py-1.5 text-xs font-bold tracking-tight transition-all duration-200 bg-[#f8f7e2] text-[#474c80] shadow-[0_2px_12px_rgba(248,247,226,0.25)] font-display"
      >
        Slopsquatting Intercept
      </button>
      <button
        type="button"
        role="tab"
        id="mode-secrets"
        aria-selected="false"
        data-inspector-tab="secrets"
        class="inspector-tab rounded-full px-4 py-1.5 text-xs font-medium tracking-tight text-[#f8f7e2]/60 transition-all duration-200 hover:text-[#f8f7e2] font-display"
      >
        Secret Quarantine
      </button>
      <button
        type="button"
        role="tab"
        id="mode-attribution"
        aria-selected="false"
        data-inspector-tab="attribution"
        class="inspector-tab rounded-full px-4 py-1.5 text-xs font-medium tracking-tight text-[#f8f7e2]/60 transition-all duration-200 hover:text-[#f8f7e2] font-display"
      >
        Attribution Radar
      </button>
    </div>

    <!-- Live Simulation Trigger -->
    <button
      type="button"
      id="run-audit-btn"
      class="group inline-flex items-center gap-2 rounded-full border border-[rgba(248,247,226,0.25)] bg-[rgba(248,247,226,0.08)] px-4 py-1.5 text-xs font-semibold text-[#f8f7e2] transition-all duration-200 hover:border-[#f8f7e2] hover:bg-[#f8f7e2] hover:text-[#474c80] hover:scale-105 active:scale-95 font-display"
    >
      <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/>
        <path d="M21 3v5h-5"/>
      </svg>
      <span>Run Live PR Audit</span>
    </button>
  </div>

  <!-- Interactive Inspector Stage -->
  <div class="relative z-10 mt-6 min-h-[300px] overflow-hidden rounded-2xl border border-[rgba(248,247,226,0.12)] bg-[#131627]/90 p-5 font-mono sm:p-6">
    <!-- Scanner Laser Beam Overlay (animated during simulation) -->
    <div
      id="scan-laser"
      class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-transparent via-[#f8f7e2] to-transparent opacity-0 shadow-[0_0_15px_#f8f7e2]"
    ></div>

    <!-- Panel 1: Slopsquatting Intercept -->
    <div id="panel-slop" class="inspector-panel space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[rgba(248,247,226,0.12)] pb-3 text-xs">
        <div class="flex items-center gap-2">
          <span class="rounded bg-[#f8f7e2] text-[#474c80] px-1.5 py-0.5 text-xs font-bold">BLOCKED</span>
          <span class="text-[#f8f7e2]/90">PR #482 · diff hunk: <code class="text-[#f8f7e2]">package.json + src/util.ts</code></span>
        </div>
        <span class="text-[#f8f7e2]/50">Rule: VS-PKG-001 (Slopsquatting / Hallucinated Package)</span>
      </div>

      <div class="rounded-xl border border-[rgba(248,247,226,0.12)] bg-[#181b30] p-4 text-sm leading-relaxed">
        <div class="text-[#f8f7e2]/40">// Cursor / Copilot generated diff hunk:</div>
        <div class="text-[#f8f7e2]/60">  dependencies: &#123;</div>
        <div class="flex items-center justify-between rounded bg-[rgba(248,247,226,0.1)] px-2 py-0.5 text-[#f8f7e2]">
          <span>+   "fast-parse-utils-v3": "^2.1.4"</span>
          <span class="rounded-lg border border-[rgba(248,247,226,0.25)] bg-[#131627] px-2 py-0.5 text-xs font-semibold text-[#f8f7e2]">
            🚨 Hallucinated Package
          </span>
        </div>
        <div class="text-[#f8f7e2]/60">  &#125;</div>
      </div>

      <div class="grid gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-[rgba(248,247,226,0.12)] bg-[rgba(248,247,226,0.05)] p-3">
          <div class="text-xs text-[#f8f7e2]/50">Domain Age</div>
          <div class="mt-1 text-sm font-semibold text-[#f8f7e2]">9 days ago</div>
          <div class="text-xs text-[#f8f7e2]/40">Registered shortly after LLM output</div>
        </div>
        <div class="rounded-xl border border-[rgba(248,247,226,0.12)] bg-[rgba(248,247,226,0.05)] p-3">
          <div class="text-xs text-[#f8f7e2]/50">Post-install Script</div>
          <div class="mt-1 text-sm font-semibold text-[#f8f7e2]">curl | sh binary</div>
          <div class="text-xs text-[#f8f7e2]/40">Remote payload execution risk</div>
        </div>
        <div class="rounded-xl border border-[rgba(248,247,226,0.12)] bg-[rgba(248,247,226,0.05)] p-3">
          <div class="text-xs text-[#f8f7e2]/50">Automated Fix</div>
          <div class="mt-1 text-sm font-semibold text-[#f8f7e2]">node:util</div>
          <div class="text-xs text-[#f8f7e2]/40">12 lines, zero dependencies</div>
        </div>
      </div>

      <div class="flex items-center justify-between rounded-xl border border-[rgba(248,247,226,0.2)] bg-[rgba(248,247,226,0.06)] px-4 py-2.5 text-xs">
        <span class="text-[#f8f7e2]/85">⚡ VibeShield Recommendation: Remove package and use built-in standard library.</span>
        <span class="font-semibold text-[#f8f7e2]">Auto-Fix Available</span>
      </div>
    </div>

    <!-- Panel 2: Secret Quarantine -->
    <div id="panel-secrets" class="inspector-panel hidden space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[rgba(248,247,226,0.12)] pb-3 text-xs">
        <div class="flex items-center gap-2">
          <span class="rounded bg-[#f8f7e2] text-[#474c80] px-1.5 py-0.5 text-xs font-bold">QUARANTINED</span>
          <span class="text-[#f8f7e2]/90">PR #482 · file: <code class="text-[#f8f7e2]">src/lib/agent.ts:41</code></span>
        </div>
        <span class="text-[#f8f7e2]/50">Rule: VS-SEC-017 (Hardcoded Secret Echo)</span>
      </div>

      <div class="rounded-xl border border-[rgba(248,247,226,0.12)] bg-[#181b30] p-4 text-sm leading-relaxed">
        <div class="text-[#f8f7e2]/40">// AI agent pasted test credentials from context memory:</div>
        <div class="flex items-center justify-between rounded bg-[rgba(248,247,226,0.1)] px-2 py-0.5 text-[#f8f7e2]">
          <span>+ const OPENAI_API_KEY = "sk-proj-49a8f••••••••••••••4a2f";</span>
          <span class="rounded-lg border border-[rgba(248,247,226,0.25)] bg-[#131627] px-2 py-0.5 text-xs font-semibold text-[#f8f7e2]">
            High Entropy Token
          </span>
        </div>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <div class="rounded-xl border border-[rgba(248,247,226,0.12)] bg-[rgba(248,247,226,0.05)] p-3">
          <div class="text-xs text-[#f8f7e2]/50">Shannon Entropy Score</div>
          <div class="mt-1 text-sm font-semibold text-[#f8f7e2]">4.88 bits/symbol (High)</div>
          <div class="text-xs text-[#f8f7e2]/40">Matches OpenAI organization production token</div>
        </div>
        <div class="rounded-xl border border-[rgba(248,247,226,0.12)] bg-[rgba(248,247,226,0.05)] p-3">
          <div class="text-xs text-[#f8f7e2]/50">Action Taken</div>
          <div class="mt-1 text-sm font-semibold text-[#f8f7e2]">Quarantine & Alert</div>
          <div class="text-xs text-[#f8f7e2]/40">Commit blocked prior to remote push</div>
        </div>
      </div>

      <div class="flex items-center justify-between rounded-xl border border-[rgba(248,247,226,0.2)] bg-[rgba(248,247,226,0.06)] px-4 py-2.5 text-xs">
        <span class="text-[#f8f7e2]/85">🔒 Protection: Key was stopped on the developer's laptop before entering GitHub.</span>
        <span class="font-semibold text-[#f8f7e2]">Rotate Suggested</span>
      </div>
    </div>

    <!-- Panel 3: Attribution Radar -->
    <div id="panel-attribution" class="inspector-panel hidden space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[rgba(248,247,226,0.12)] pb-3 text-xs">
        <div class="flex items-center gap-2">
          <span class="rounded bg-[#f8f7e2] text-[#474c80] px-1.5 py-0.5 text-xs font-bold">ANALYZED</span>
          <span class="text-[#f8f7e2]/90">Attribution Breakdown · 14 files, 512 lines changed</span>
        </div>
        <span class="text-[#f8f7e2]/50">VibeCheck Diff Attribution Engine</span>
      </div>

      <div class="space-y-3">
        <div>
          <div class="flex justify-between text-xs text-[#f8f7e2]/70 mb-1">
            <span>AI Model Generated (Cursor / Claude Code)</span>
            <span class="text-[#f8f7e2] font-bold">78% (399 lines)</span>
          </div>
          <div class="h-2 w-full overflow-hidden rounded-full bg-[rgba(248,247,226,0.15)]">
            <div class="h-full bg-[#f8f7e2] transition-all duration-500" style="width: 78%"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs text-[#f8f7e2]/70 mb-1">
            <span>Human Developer Authored</span>
            <span class="text-[#f8f7e2] font-bold">22% (113 lines)</span>
          </div>
          <div class="h-2 w-full overflow-hidden rounded-full bg-[rgba(248,247,226,0.15)]">
            <div class="h-full bg-[#474c80] border border-[rgba(248,247,226,0.3)] transition-all duration-500" style="width: 22%"></div>
          </div>
        </div>
      </div>

      <div class="rounded-xl border border-[rgba(248,247,226,0.12)] bg-[#181b30] p-4 text-xs sm:text-sm font-mono leading-relaxed">
        <div class="text-[#f8f7e2]/40">// Hunk origin metadata embedded into PR review comment:</div>
        <div class="text-[#f8f7e2]/80">@@ -82,6 +82,9 @@ export async function handleWebhook(req) &#123;</div>
        <div class="text-[#f8f7e2] bg-[rgba(248,247,226,0.1)] px-2 py-0.5 rounded">+  // AI-Origin: Claude-3.5-Sonnet (vibe-score: 0.94)</div>
        <div class="text-[#f8f7e2] bg-[rgba(248,247,226,0.1)] px-2 py-0.5 rounded">+  const signature = req.headers['x-hub-signature-256'];</div>
      </div>
    </div>
  </div>

  <!-- Bottom Metric Counters Bar -->
  <div class="relative z-10 mt-6 grid grid-cols-2 gap-5 border-t border-[rgba(248,247,226,0.12)] pt-6 sm:grid-cols-4">
    <div>
      <div class="text-xs font-medium text-[#f8f7e2]/50">Audit Duration</div>
      <div class="mt-1.5 font-mono text-xl font-bold tracking-tight text-[#f8f7e2]"><span data-countup="1.2" data-suffix="s">1.2s</span></div>
      <div class="mt-1.5 text-xs text-[#f8f7e2]/50 leading-normal">sub-second diff scan</div>
    </div>
    <div>
      <div class="text-xs font-medium text-[#f8f7e2]/50">Language Rulepacks</div>
      <div class="mt-1.5 font-mono text-xl font-bold tracking-tight text-[#f8f7e2]"><span data-countup="120" data-suffix="+">120+</span></div>
      <div class="mt-1.5 text-xs text-[#f8f7e2]/50 leading-normal">8 supported languages</div>
    </div>
    <div>
      <div class="text-xs font-medium text-[#f8f7e2]/50">Hallucinations Caught</div>
      <div class="mt-1.5 font-mono text-xl font-bold tracking-tight text-[#f8f7e2]"><span data-countup="100" data-suffix="%">100%</span></div>
      <div class="mt-1.5 text-xs text-[#f8f7e2]/50 leading-normal">pre-merge prevention</div>
    </div>
    <div>
      <div class="text-xs font-medium text-[#f8f7e2]/50">Cost & Licensing</div>
      <div class="mt-1.5 font-mono text-xl font-bold tracking-tight text-[#f8f7e2]">MIT FREE</div>
      <div class="mt-1.5 text-xs text-[#f8f7e2]/50 leading-normal">zero fees forever</div>
    </div>
  </div>
</div>

<script>
  // Segmented Controller Switcher & Live Simulation
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-inspector-tab]');
  const panels: Record<string, HTMLElement | null> = {
    slop: document.getElementById('panel-slop'),
    secrets: document.getElementById('panel-secrets'),
    attribution: document.getElementById('panel-attribution'),
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const mode = tab.dataset.inspectorTab;
      if (!mode) return;

      tabs.forEach((t) => {
        const active = t === tab;
        t.setAttribute('aria-selected', String(active));
        if (active) {
          t.className =
            'inspector-tab rounded-full px-4 py-1.5 text-xs font-bold tracking-tight transition-all duration-200 bg-[#f8f7e2] text-[#474c80] shadow-[0_2px_12px_rgba(248,247,226,0.25)] font-display';
        } else {
          t.className =
            'inspector-tab rounded-full px-4 py-1.5 text-xs font-medium tracking-tight text-[#f8f7e2]/60 transition-all duration-200 hover:text-[#f8f7e2] font-display';
        }
      });

      Object.entries(panels).forEach(([k, panel]) => {
        if (!panel) return;
        if (k === mode) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    });
  });

  // Live Audit simulation
  const runBtn = document.getElementById('run-audit-btn');
  const laser = document.getElementById('scan-laser');
  let isAuditing = false;

  runBtn?.addEventListener('click', () => {
    if (isAuditing || !laser) return;
    isAuditing = true;
    runBtn.innerHTML = `
      <svg class="h-3.5 w-3.5 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10" stroke-opacity="0.25"/>
        <path d="M12 2a10 10 0 0 1 10 10"/>
      </svg>
      <span>Auditing Diff...</span>
    `;

    laser.style.opacity = '1';
    laser.style.transition = 'top 1.2s ease-in-out';
    laser.style.top = '100%';

    setTimeout(() => {
      laser.style.opacity = '0';
      laser.style.top = '0';
      runBtn.innerHTML = `
        <svg class="h-3.5 w-3.5 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>Audit Complete ✓</span>
      `;

      setTimeout(() => {
        runBtn.innerHTML = `
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/>
            <path d="M21 3v5h-5"/>
          </svg>
          <span>Run Live PR Audit</span>
        `;
        isAuditing = false;
      }, 2000);
    }, 1250);
  });
</script>
