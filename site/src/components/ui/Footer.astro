---
import { FOOTER } from '../../data/site';
import { baseHref } from '../../lib/base';
---

<footer class="border-t border-white/10 bg-black relative">
  <div class="wrap section !py-16">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-5">
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center gap-2 font-semibold tracking-tight text-sm text-white">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 2 4 5.5V11c0 5 3.2 8.9 8 10.5 4.8-1.6 8-5.5 8-10.5V5.5L12 2Z"
              stroke="#ffffff"
              stroke-width="2"
              fill="rgba(255, 255, 255, 0.15)"
            />
          </svg>
          <span>VibeShield</span>
        </div>
        <p class="mt-3 max-w-56 text-xs text-white/50 leading-relaxed">
          The security gate for code your AI writes. MIT licensed, fully free.
        </p>
      </div>

      {FOOTER.cols.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="text-xs font-mono uppercase tracking-wider text-white/40">{col.title}</h2>
          <ul class="mt-4 space-y-2.5">
            {col.links.map(([label, href]) => (
              <li>
                <a href={baseHref(href)} class="text-xs text-white/60 transition-colors duration-150 hover:text-white">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-6 text-xs font-mono text-white/40">
      <span>{FOOTER.bottom}</span>
      <span aria-label="Language">
        {FOOTER.langs.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            {l === 'en' ? <span class="text-white font-semibold">en</span> : <span>{l}</span>}
          </>
        ))}
      </span>
    </div>
  </div>
</footer>
