---
/**
 * Instant AI Code Safety Checker — What VibeShield Does
 * Clean, light-mode interactive diff inspector with East Bay and Rum Swizzle palette.
 */
---

<section class="border-t border-[rgba(71,76,128,0.15)] relative py-16 lg:py-24 bg-[#faf9f0]">
  <div class="wrap">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-[rgba(71,76,128,0.22)] bg-white px-3.5 py-1.5 shadow-sm mb-3">
        <span class="h-2 w-2 rounded-full bg-[#474c80]"></span>
        <span class="font-display text-xs font-bold tracking-wider text-[#474c80] uppercase">
          Audit Matrix
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-[-0.03em] text-[#474c80] font-display">
        Live Code Inspector & Threat Detector
      </h2>
      <p class="mt-3 text-sm sm:text-base text-[#474c80]/80 font-sans">
        Experience how VibeShield flags dangerous AI code patterns in real-time — from hallucinated package names to leaked API keys, with verified atomic fixes.
      </p>
    </div>

    <!-- Interactive Simulator Card -->
    <div class="card mt-10 max-w-3xl mx-auto rounded-2xl border border-[rgba(71,76,128,0.22)] bg-white p-6 sm:p-8 shadow-sm">
      <!-- Preset Buttons Header -->
      <div class="text-xs font-bold text-[#474c80] mb-3 tracking-wider uppercase font-display">
        Select a real AI code scenario to test:
      </div>
      <div class="flex flex-wrap gap-2.5" role="tablist">
        <button
          type="button"
          data-preset="slop"
          class="preset-btn flex items-center gap-2 rounded-full bg-[#474c80] text-[#f8f7e2] px-4 py-2 text-xs font-bold font-display shadow-sm transition-colors"
        >
          <span>🚨 Hallucinated Package</span>
        </button>
        <button
          type="button"
          data-preset="secret"
          class="preset-btn flex items-center gap-2 rounded-full border border-[rgba(71,76,128,0.25)] bg-[#faf9f0] text-[#474c80] px-4 py-2 text-xs font-bold hover:border-[#474c80] transition-colors font-display"
        >
          <span>🔑 Leaked API Key</span>
        </button>
        <button
          type="button"
          data-preset="safe"
          class="preset-btn flex items-center gap-2 rounded-full border border-[rgba(71,76,128,0.25)] bg-[#faf9f0] text-[#474c80] px-4 py-2 text-xs font-bold hover:border-[#474c80] transition-colors font-display"
        >
          <span>✅ Legitimate Package</span>
        </button>
      </div>

      <!-- Live Inspection Box -->
      <div id="inspector-output" class="mt-6 rounded-xl border border-[rgba(71,76,128,0.18)] bg-[#faf9f0] p-5 font-mono text-xs sm:text-sm">
        <div class="flex items-center justify-between border-b border-[rgba(71,76,128,0.15)] pb-3">
          <div class="flex items-center gap-2">
            <span id="badge-status" class="rounded-md bg-[#b91c1c] text-white px-2 py-0.5 text-xs font-bold">
              CRITICAL BLOCK
            </span>
            <span id="badge-source" class="text-[#474c80] font-semibold">PR #482 · package.json</span>
          </div>
          <span id="badge-time" class="text-[#474c80]/70 text-xs font-semibold">0.38s local scan</span>
        </div>

        <div class="mt-4 space-y-4">
          <div>
            <div class="text-[#474c80] text-xs font-bold uppercase tracking-wider mb-2 font-display">Scanned Code Line</div>
            <div id="code-snippet" class="rounded-lg border border-[rgba(185,28,28,0.25)] bg-white p-3 text-[#b91c1c] font-bold">
              + import &#123; parse &#125; from "fast-parse-utils-v3";
            </div>
          </div>

          <div>
            <div class="text-[#474c80] text-xs font-bold uppercase tracking-wider mb-2 font-display">AI Threat Analysis</div>
            <p id="analysis-text" class="rounded-lg bg-white border border-[rgba(71,76,128,0.18)] p-3 text-[#474c80]/85 leading-relaxed font-sans text-xs sm:text-sm">
              Cursor agent hallucinated a plausible package name. Threat actors register these hallucinated names on npm within hours to execute remote payloads during npm install.
            </p>
          </div>

          <div class="rounded-xl border border-[rgba(21,128,61,0.3)] bg-white p-3.5 flex items-start gap-2.5">
            <span class="text-[#15803d] font-bold text-base leading-none">✓</span>
            <div>
              <div class="text-xs text-[#15803d] font-bold uppercase tracking-wider mb-1 font-display">VibeShield Recommended Fix</div>
              <div id="fix-text" class="text-[#474c80] font-medium font-sans">
                Replace with native <code class="font-bold text-[#15803d] font-mono">node:util</code> (clean, 12 lines, zero extra dependencies).
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 3 Workflow Steps -->
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-[rgba(71,76,128,0.15)] pt-6">
        <div class="flex items-start gap-3">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#474c80] font-display text-xs font-bold text-[#f8f7e2]">1</div>
          <div>
            <div class="text-xs font-bold text-[#474c80] font-display">Write with AI</div>
            <p class="text-xs text-[#474c80]/75 mt-0.5 font-sans">Generate code with Cursor, Copilot, or Claude Code.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#474c80] font-display text-xs font-bold text-[#f8f7e2]">2</div>
          <div>
            <div class="text-xs font-bold text-[#474c80] font-display">Audit Staged Diff</div>
            <p class="text-xs text-[#474c80]/75 mt-0.5 font-sans">VibeShield inspects changed lines in sub-second offline check.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#474c80] font-display text-xs font-bold text-[#f8f7e2]">3</div>
          <div>
            <div class="text-xs font-bold text-[#474c80] font-display">Merge Safely</div>
            <p class="text-xs text-[#474c80]/75 mt-0.5 font-sans">Apply 1-line atomic fixes with zero security regressions.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const presets: Record<string, {
    status: string;
    statusClass: string;
    source: string;
    code: string;
    codeClass: string;
    analysis: string;
    fix: string;
  }> = {
    slop: {
      status: 'CRITICAL BLOCK',
      statusClass: 'bg-[#b91c1c] text-white font-bold',
      source: 'PR #482 · package.json',
      code: '+ import { parse } from "fast-parse-utils-v3";',
      codeClass: 'rounded-lg border border-[rgba(185,28,28,0.25)] bg-white p-3 text-[#b91c1c] font-bold',
      analysis: 'Cursor agent hallucinated a plausible package name. Threat actors register these hallucinated names on npm within hours to execute remote payloads during npm install.',
      fix: 'Replace with native node:util (clean, 12 lines, zero extra dependencies).',
    },
    secret: {
      status: 'KEY QUARANTINE',
      statusClass: 'bg-[#c2410c] text-white font-bold',
      source: 'PR #482 · src/agent.ts:41',
      code: '+ const OPENAI_API_KEY = "sk-proj-49a8f••••••••••••••4a2f";',
      codeClass: 'rounded-lg border border-[rgba(194,65,12,0.25)] bg-white p-3 text-[#c2410c] font-bold',
      analysis: 'Copilot pasted credentials recalled from session context memory. High-entropy key scanner identified active production OpenAI token structure.',
      fix: 'Read from process.env.OPENAI_API_KEY and rotate the leaked key immediately.',
    },
    safe: {
      status: 'CLEAN CHECK',
      statusClass: 'bg-[#15803d] text-white font-bold',
      source: 'PR #482 · package.json',
      code: '+ import { z } from "zod";',
      codeClass: 'rounded-lg border border-[rgba(21,128,61,0.25)] bg-white p-3 text-[#15803d] font-bold',
      analysis: 'Legitimate library: 10+ years registered, 30M+ weekly downloads, clean maintainer history, and verified provenance.',
      fix: 'No action needed. Dependency is verified and safe to merge.',
    },
  };

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-preset]');
  const badgeStatus = document.getElementById('badge-status');
  const badgeSource = document.getElementById('badge-source');
  const codeSnippet = document.getElementById('code-snippet');
  const analysisText = document.getElementById('analysis-text');
  const fixText = document.getElementById('fix-text');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.preset;
      if (!key || !presets[key]) return;
      const data = presets[key];

      buttons.forEach((b) => {
        if (b === btn) {
          b.className = 'preset-btn flex items-center gap-2 rounded-full bg-[#474c80] text-[#f8f7e2] px-4 py-2 text-xs font-bold font-display shadow-sm transition-colors';
        } else {
          b.className = 'preset-btn flex items-center gap-2 rounded-full border border-[rgba(71,76,128,0.25)] bg-[#faf9f0] text-[#474c80] px-4 py-2 text-xs font-bold hover:border-[#474c80] transition-colors font-display';
        }
      });

      if (badgeStatus) {
        badgeStatus.textContent = data.status;
        badgeStatus.className = `rounded-md px-2 py-0.5 text-xs font-bold ${data.statusClass}`;
      }
      if (badgeSource) badgeSource.textContent = data.source;
      if (codeSnippet) {
        codeSnippet.textContent = data.code;
        codeSnippet.className = data.codeClass;
      }
      if (analysisText) analysisText.textContent = data.analysis;
      if (fixText) fixText.textContent = data.fix;
    });
  });
</script>
