---
/**
 * Instant AI Code Safety Checker — Live Code Inspector
 * Mid-Page Indigo Block (--ink) with high-contrast cream surface card.
 */
---

<section
  id="scanner"
  class="section relative"
  style="background-color: var(--ink); color: var(--on-ink); border-top: 1px solid var(--border);"
>
  <div class="wrap">
    <!-- Header -->
    <div class="max-w-2xl">
      <div
        class="inline-flex items-center gap-2 rounded-full px-3 py-1 mb-3"
        style="border: 1px solid var(--border-on-ink); background: color-mix(in srgb, var(--on-ink) 10%, transparent);"
      >
        <span class="h-2 w-2 rounded-full" style="background: var(--on-ink)"></span>
        <span class="eyebrow" style="color: var(--on-ink)">
          Audit Matrix
        </span>
      </div>
      <h2 style="color: var(--on-ink)">
        Live Code Inspector &amp; Threat Detector
      </h2>
      <p class="mt-3 text-base sm:text-lg font-sans" style="color: var(--on-ink-soft)">
        Inspect how VibeShield flags dangerous AI code patterns in real-time — from hallucinated package names to leaked API keys, with verified atomic fixes.
      </p>
    </div>

    <!-- Interactive Simulator Card on Cream Surface -->
    <div
      class="card mt-10 max-w-3xl p-6 sm:p-8"
      style="background: var(--surface); color: var(--ink); border: 1px solid var(--border-on-ink);"
    >
      <!-- Preset Buttons Header -->
      <div class="eyebrow mb-3" style="color: var(--ink-soft)">
        Select an AI code scenario to test:
      </div>
      <div class="flex flex-wrap gap-2.5" role="tablist">
        <button
          type="button"
          data-preset="slop"
          class="preset-btn flex items-center gap-2 rounded-full px-4 py-2 text-xs font-bold font-display transition-colors"
          style="background: var(--ink); color: var(--on-ink); border: 1px solid var(--ink);"
        >
          <span>Hallucinated Package</span>
        </button>
        <button
          type="button"
          data-preset="secret"
          class="preset-btn flex items-center gap-2 rounded-full px-4 py-2 text-xs font-bold font-display transition-colors"
          style="background: var(--bg); color: var(--ink); border: 1px solid var(--border);"
        >
          <span>Leaked API Key</span>
        </button>
        <button
          type="button"
          data-preset="safe"
          class="preset-btn flex items-center gap-2 rounded-full px-4 py-2 text-xs font-bold font-display transition-colors"
          style="background: var(--bg); color: var(--ink); border: 1px solid var(--border);"
        >
          <span>Verified Package</span>
        </button>
      </div>

      <!-- Live Inspection Box -->
      <div
        id="inspector-output"
        class="mt-6 rounded-xl p-5 font-mono text-xs sm:text-sm"
        style="background: var(--bg); border: 1px solid var(--border); color: var(--ink);"
      >
        <div class="flex items-center justify-between pb-3" style="border-bottom: 1px solid var(--border)">
          <div class="flex items-center gap-2">
            <span
              id="badge-status"
              class="rounded px-2 py-0.5 text-xs font-bold font-mono"
              style="background: color-mix(in srgb, var(--danger) 14%, var(--bg)); color: var(--danger); border: 1px solid var(--danger);"
            >
              CRITICAL BLOCK
            </span>
            <span id="badge-source" class="font-semibold" style="color: var(--ink)">PR #482 · package.json</span>
          </div>
          <span id="badge-time" class="text-xs font-semibold" style="color: var(--ink-soft)">0.38s local scan</span>
        </div>

        <div class="mt-4 space-y-4">
          <div>
            <div class="eyebrow mb-2" style="color: var(--ink-soft)">Scanned Code Line</div>
            <div
              id="code-snippet"
              class="rounded-lg p-3 font-bold"
              style="border: 1px solid var(--danger); background: color-mix(in srgb, var(--danger) 8%, var(--bg)); color: var(--danger);"
            >
              + import &#123; parse &#125; from "fast-parse-utils-v3";
            </div>
          </div>

          <div>
            <div class="eyebrow mb-2" style="color: var(--ink-soft)">Threat Analysis</div>
            <p
              id="analysis-text"
              class="rounded-lg p-3 leading-relaxed font-sans text-xs sm:text-sm"
              style="background: var(--surface); border: 1px solid var(--border); color: var(--ink);"
            >
              Cursor agent hallucinated a plausible package name. Threat actors register these hallucinated names on npm within hours to execute remote payloads during npm install.
            </p>
          </div>

          <div
            class="rounded-xl p-3.5 flex items-start gap-2.5"
            style="border: 1px solid var(--ok); background: color-mix(in srgb, var(--ok) 8%, var(--bg));"
          >
            <span class="font-bold text-base leading-none" style="color: var(--ok)">✓</span>
            <div>
              <div class="eyebrow mb-1" style="color: var(--ok)">Recommended Fix</div>
              <div id="fix-text" class="font-medium font-sans" style="color: var(--ink)">
                Replace with native <code class="font-bold font-mono" style="color: var(--ok)">node:util</code> (clean, 12 lines, zero extra dependencies).
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 3 Workflow Steps -->
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6" style="border-top: 1px solid var(--border)">
        <div class="flex items-start gap-3">
          <div
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full font-display text-xs font-bold"
            style="background: var(--ink); color: var(--on-ink)"
          >
            1
          </div>
          <div>
            <div class="text-xs font-bold font-display" style="color: var(--ink)">Write with AI</div>
            <p class="text-xs mt-0.5 font-sans" style="color: var(--ink-soft)">Generate code with Cursor, Copilot, or Claude Code.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full font-display text-xs font-bold"
            style="background: var(--ink); color: var(--on-ink)"
          >
            2
          </div>
          <div>
            <div class="text-xs font-bold font-display" style="color: var(--ink)">Audit Staged Diff</div>
            <p class="text-xs mt-0.5 font-sans" style="color: var(--ink-soft)">VibeShield inspects changed lines in sub-second offline check.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full font-display text-xs font-bold"
            style="background: var(--ink); color: var(--on-ink)"
          >
            3
          </div>
          <div>
            <div class="text-xs font-bold font-display" style="color: var(--ink)">Merge Safely</div>
            <p class="text-xs mt-0.5 font-sans" style="color: var(--ink-soft)">Apply 1-line atomic fixes with zero security regressions.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const presets: Record<string, {
    status: string;
    statusStyle: string;
    source: string;
    code: string;
    codeStyle: string;
    analysis: string;
    fix: string;
  }> = {
    slop: {
      status: 'CRITICAL BLOCK',
      statusStyle: 'background: color-mix(in srgb, var(--danger) 14%, var(--bg)); color: var(--danger); border: 1px solid var(--danger);',
      source: 'PR #482 · package.json',
      code: '+ import { parse } from "fast-parse-utils-v3";',
      codeStyle: 'border: 1px solid var(--danger); background: color-mix(in srgb, var(--danger) 8%, var(--bg)); color: var(--danger);',
      analysis: 'Cursor agent hallucinated a plausible package name. Threat actors register these hallucinated names on npm within hours to execute remote payloads during npm install.',
      fix: 'Replace with native node:util (clean, 12 lines, zero extra dependencies).',
    },
    secret: {
      status: 'KEY QUARANTINE',
      statusStyle: 'background: color-mix(in srgb, var(--warn) 14%, var(--bg)); color: var(--warn); border: 1px solid var(--warn);',
      source: 'PR #482 · src/agent.ts:41',
      code: '+ const OPENAI_API_KEY = "sk-proj-49a8f••••••••••••••4a2f";',
      codeStyle: 'border: 1px solid var(--warn); background: color-mix(in srgb, var(--warn) 8%, var(--bg)); color: var(--warn);',
      analysis: 'Copilot pasted credentials recalled from session context memory. High-entropy key scanner identified active production OpenAI token structure.',
      fix: 'Read from process.env.OPENAI_API_KEY and rotate the leaked key immediately.',
    },
    safe: {
      status: 'CLEAN CHECK',
      statusStyle: 'background: color-mix(in srgb, var(--ok) 14%, var(--bg)); color: var(--ok); border: 1px solid var(--ok);',
      source: 'PR #482 · package.json',
      code: '+ import { z } from "zod";',
      codeStyle: 'border: 1px solid var(--ok); background: color-mix(in srgb, var(--ok) 8%, var(--bg)); color: var(--ok);',
      analysis: 'Legitimate library: 10+ years registered, 30M+ weekly downloads, clean maintainer history, and verified provenance.',
      fix: 'No action needed. Dependency is verified and safe to merge.',
    },
  };

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-preset]');
  const badgeStatus = document.getElementById('badge-status');
  const badgeSource = document.getElementById('badge-source');
  const codeSnippet = document.getElementById('code-snippet');
  const analysisText = document.getElementById('analysis-text');
  const fixText = document.getElementById('fix-text');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.preset;
      if (!key || !presets[key]) return;
      const data = presets[key];

      buttons.forEach((b) => {
        if (b === btn) {
          b.style.background = 'var(--ink)';
          b.style.color = 'var(--on-ink)';
          b.style.borderColor = 'var(--ink)';
        } else {
          b.style.background = 'var(--bg)';
          b.style.color = 'var(--ink)';
          b.style.borderColor = 'var(--border)';
        }
      });

      if (badgeStatus) {
        badgeStatus.textContent = data.status;
        badgeStatus.setAttribute('style', `rounded px-2 py-0.5 text-xs font-bold font-mono; ${data.statusStyle}`);
      }
      if (badgeSource) badgeSource.textContent = data.source;
      if (codeSnippet) {
        codeSnippet.textContent = data.code;
        codeSnippet.setAttribute('style', `rounded-lg p-3 font-bold; ${data.codeStyle}`);
      }
      if (analysisText) analysisText.textContent = data.analysis;
      if (fixText) fixText.textContent = data.fix;
    });
  });
</script>
