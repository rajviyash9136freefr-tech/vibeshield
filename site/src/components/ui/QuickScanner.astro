---
/**
 * Instant AI Code Safety Checker — What VibeShield Does
 * Solves: "add a useful for website users come and easily identify website What do for"
 */
---

<section class="border-t border-[rgba(248,247,226,0.12)] relative py-16 lg:py-20 bg-gradient-to-b from-[#181b30] via-[#242848] to-[#181b30]" data-cinematic>
  <div class="wrap">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto" data-reveal>
      <div class="inline-flex items-center gap-2 rounded-full border border-[rgba(248,247,226,0.18)] bg-[rgba(248,247,226,0.06)] px-3.5 py-1.5 backdrop-blur-md mb-3">
        <span class="h-1.5 w-1.5 rounded-full bg-[#f8f7e2] animate-pulse"></span>
        <span class="font-display text-xs font-bold tracking-wider text-[#f8f7e2] uppercase">
          Interactive Audit Simulator
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-[-0.03em] text-apple-headline font-display">
        Live Bug Hunter & Tester
      </h2>
      <p class="mt-3 text-sm sm:text-base text-[#f8f7e2]/70 font-sans">
        See how VibeShield hunts down real AI vibe coding bugs in real time — from hallucinated dependencies to leaked secrets, with instant 1-line fixes.
      </p>
    </div>

    <!-- Interactive Simulator Card -->
    <div class="card mt-10 max-w-3xl mx-auto rounded-3xl border border-[rgba(248,247,226,0.18)] bg-[#242848] p-6 sm:p-8 shadow-[0_20px_60px_-15px_rgba(19,22,39,0.95)] transition-all duration-300 hover:border-[rgba(248,247,226,0.35)]" data-reveal data-tilt="3">
      <!-- Preset Buttons Header -->
      <div class="text-xs font-bold text-[#f8f7e2]/90 mb-3 tracking-wide uppercase font-display">
        Select a real AI code scenario to test:
      </div>
      <div class="flex flex-wrap gap-2.5" role="tablist">
        <button
          type="button"
          data-preset="slop"
          class="preset-btn flex items-center gap-2 rounded-full border border-[#f8f7e2] bg-[#f8f7e2] text-[#474c80] px-4 py-2 text-xs font-bold font-display shadow-[0_0_15px_rgba(248,247,226,0.25)] transition-all"
        >
          <span>🚨 Hallucinated Package</span>
        </button>
        <button
          type="button"
          data-preset="secret"
          class="preset-btn flex items-center gap-2 rounded-full border border-[rgba(248,247,226,0.2)] bg-[rgba(248,247,226,0.06)] text-[#f8f7e2]/75 px-4 py-2 text-xs font-medium hover:text-[#f8f7e2] hover:border-[rgba(248,247,226,0.4)] transition-all font-display"
        >
          <span>🔑 Leaked API Key</span>
        </button>
        <button
          type="button"
          data-preset="safe"
          class="preset-btn flex items-center gap-2 rounded-full border border-[rgba(248,247,226,0.2)] bg-[rgba(248,247,226,0.06)] text-[#f8f7e2]/75 px-4 py-2 text-xs font-medium hover:text-[#f8f7e2] hover:border-[rgba(248,247,226,0.4)] transition-all font-display"
        >
          <span>✅ Legitimate Package</span>
        </button>
      </div>

      <!-- Live Inspection Box -->
      <div id="inspector-output" class="mt-6 rounded-2xl border border-[rgba(248,247,226,0.12)] bg-[#131627]/90 p-5 font-mono text-xs sm:text-sm">
        <div class="flex items-center justify-between border-b border-[rgba(248,247,226,0.12)] pb-3">
          <div class="flex items-center gap-2">
            <span id="badge-status" class="rounded-md bg-[#f8f7e2] text-[#474c80] px-2 py-0.5 text-xs font-bold">
              CRITICAL BLOCK
            </span>
            <span id="badge-source" class="text-[#f8f7e2]/85">AI PR Diff Check</span>
          </div>
          <span id="badge-time" class="text-[#f8f7e2]/50 text-xs">1.2s local audit</span>
        </div>

        <div class="mt-4 space-y-4">
          <div>
            <div class="text-[#f8f7e2]/60 text-xs font-medium uppercase tracking-wider mb-2 font-display">Scanned Code Line</div>
            <div id="code-snippet" class="rounded-lg bg-[rgba(248,247,226,0.1)] p-3 text-[#f8f7e2] font-semibold">
              + import &#123; parse &#125; from "fast-parse-utils-v3";
            </div>
          </div>

          <div>
            <div class="text-[#f8f7e2]/60 text-xs font-medium uppercase tracking-wider mb-2 font-display">AI Threat Analysis</div>
            <p id="analysis-text" class="rounded-lg bg-[rgba(248,247,226,0.04)] border border-[rgba(248,247,226,0.12)] p-3 text-[#f8f7e2]/80 leading-relaxed font-sans text-xs sm:text-sm">
              Cursor agent hallucinated a plausible package name. Threat actors register these hallucinated names within hours on npm to execute remote binaries during <code class="text-[#f8f7e2]">npm install</code>.
            </p>
          </div>

          <div class="rounded-xl border border-[rgba(248,247,226,0.2)] bg-[rgba(248,247,226,0.06)] p-3.5 flex items-start gap-2.5">
            <span class="text-[#f8f7e2] font-bold">→</span>
            <div>
              <div class="text-xs text-[#f8f7e2]/60 font-medium uppercase tracking-wider mb-1 font-display">VibeShield Recommended Fix</div>
              <div id="fix-text" class="text-[#f8f7e2] font-medium font-sans">
                Replace with native <code class="text-[#f8f7e2] underline font-mono">node:util</code> (clean, 12 lines, zero dependencies).
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 3 Workflow Steps -->
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-[rgba(248,247,226,0.12)] pt-6">
        <div class="flex items-start gap-3">
          <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[rgba(248,247,226,0.15)] font-display text-xs font-bold text-[#f8f7e2]">1</div>
          <div>
            <div class="text-xs font-bold text-[#f8f7e2] font-display">Write with AI</div>
            <p class="text-xs text-[#f8f7e2]/65 mt-0.5 font-sans">Use Cursor, Copilot, or Claude Code as usual.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[rgba(248,247,226,0.15)] font-display text-xs font-bold text-[#f8f7e2]">2</div>
          <div>
            <div class="text-xs font-bold text-[#f8f7e2] font-display">VibeShield Audits PR</div>
            <p class="text-xs text-[#f8f7e2]/65 mt-0.5 font-sans">Scans PR diff in 1.2s offline before merge.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[rgba(248,247,226,0.15)] font-display text-xs font-bold text-[#f8f7e2]">3</div>
          <div>
            <div class="text-xs font-bold text-[#f8f7e2] font-display">Merge Safely</div>
            <p class="text-xs text-[#f8f7e2]/65 mt-0.5 font-sans">Zero hallucinations or secrets ever reach main.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const presets: Record<string, {
    status: string;
    statusClass: string;
    source: string;
    code: string;
    analysis: string;
    fix: string;
  }> = {
    slop: {
      status: 'CRITICAL BLOCK',
      statusClass: 'bg-[#f8f7e2] text-[#474c80] font-bold',
      source: 'PR #482 · package.json',
      code: '+ import { parse } from "fast-parse-utils-v3";',
      analysis: 'Cursor agent hallucinated a plausible package name. Threat actors register these hallucinated names on npm within hours to execute remote payloads on install.',
      fix: 'Replace with native node:util (clean, 12 lines, zero dependencies).',
    },
    secret: {
      status: 'QUARANTINE',
      statusClass: 'border border-[rgba(248,247,226,0.3)] bg-[#474c80] text-[#f8f7e2] font-bold',
      source: 'PR #482 · src/agent.ts:41',
      code: '+ const OPENAI_API_KEY = "sk-proj-49a8f••••••••••••••4a2f";',
      analysis: 'Copilot pasted test credentials echoed out of local context memory. Entropy detection identified production OpenAI token structure.',
      fix: 'Move to process.env.OPENAI_API_KEY and rotate the leaked key immediately.',
    },
    safe: {
      status: 'CLEAN CHECK',
      statusClass: 'bg-[#f8f7e2] text-[#474c80] font-bold',
      source: 'PR #482 · package.json',
      code: '+ import { z } from "zod";',
      analysis: 'Legitimate library: 10+ years registered, 30M+ weekly downloads, clean maintainer history, no install hooks.',
      fix: 'No action needed. Dependency is verified and safe to merge.',
    },
  };

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-preset]');
  const badgeStatus = document.getElementById('badge-status');
  const badgeSource = document.getElementById('badge-source');
  const codeSnippet = document.getElementById('code-snippet');
  const analysisText = document.getElementById('analysis-text');
  const fixText = document.getElementById('fix-text');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.preset;
      if (!key || !presets[key]) return;
      const data = presets[key];

      buttons.forEach((b) => {
        if (b === btn) {
          b.className = 'preset-btn flex items-center gap-2 rounded-full border border-[#f8f7e2] bg-[#f8f7e2] text-[#474c80] px-4 py-2 text-xs font-bold font-display shadow-[0_0_15px_rgba(248,247,226,0.25)] transition-all';
        } else {
          b.className = 'preset-btn flex items-center gap-2 rounded-full border border-[rgba(248,247,226,0.2)] bg-[rgba(248,247,226,0.06)] text-[#f8f7e2]/75 px-4 py-2 text-xs font-medium hover:text-[#f8f7e2] hover:border-[rgba(248,247,226,0.4)] transition-all font-display';
        }
      });

      if (badgeStatus) {
        badgeStatus.textContent = data.status;
        badgeStatus.className = `rounded-md px-2 py-0.5 text-xs font-bold ${data.statusClass}`;
      }
      if (badgeSource) badgeSource.textContent = data.source;
      if (codeSnippet) codeSnippet.textContent = data.code;
      if (analysisText) analysisText.textContent = data.analysis;
      if (fixText) fixText.textContent = data.fix;
    });
  });
</script>
