---
/**
 * Hero demo (UIUX §3.2): a monospace terminal card that "types" a VibeCheck
 * run. Signature motion = the only looping animation. Static final frame when
 * reduced-motion or < lg (battery, §6). Final frame doubles as OG source.
 */
import { DEMO_LINES } from '../../data/site';

function lineClass(cls: string): string {
  switch (cls) {
    case 'accent': return 'text-[var(--color-accent)]';
    case 'muted': return 'text-[var(--color-muted)]';
    case 'faint': return 'text-[var(--color-faint)]';
    case 'critical': return 'font-semibold text-[var(--color-critical)]';
    case 'high': return 'font-semibold text-[var(--color-high)]';
    case 'ok': return 'text-[var(--color-ok)]';
    case 'fg': return 'text-[var(--color-fg)]';
    default: return '';
  }
}
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const initialHtml = DEMO_LINES.map(
  (l) => `<span class="${lineClass(l.cls)}">${esc(l.text) || '&nbsp;'}</span>`,
).join('\n');
---

<div
  class="card overflow-hidden"
  data-tilt="4"
  role="img"
  aria-label="Terminal showing a VibeShield scan: one critical hallucinated-package finding and one high hardcoded-secret finding, 11 files clean"
>
  <div class="flex items-center gap-2 border-b border-[var(--color-hairline)] px-4 py-3">
    <span class="h-3 w-3 rounded-full bg-[var(--color-critical)]" aria-hidden="true"></span>
    <span class="h-3 w-3 rounded-full bg-[var(--color-medium)]" aria-hidden="true"></span>
    <span class="h-3 w-3 rounded-full bg-[var(--color-ok)]" aria-hidden="true"></span>
    <span class="ml-2 font-mono text-[13px] text-[var(--color-muted)]">bash — vibeshield</span>
  </div>
  <pre
    id="demo-body"
    class="min-h-[340px] px-4 py-4 font-mono text-[13.5px] leading-[1.7] sm:min-h-[360px]"
    data-lines={JSON.stringify(DEMO_LINES.map((l) => ({ t: l.text, c: l.cls })))}
  ><code set:html={initialHtml} /></pre>
</div>

<script>
  // Signature motion (UIUX §3.2): character-by-character reveal of the scan,
  // 2.5 s hold on the final frame, loop. Off for prefers-reduced-motion and
  // below the lg breakpoint (static final frame — server-rendered above).
  const body = document.getElementById('demo-body');
  const reduced = document.documentElement.dataset.reducedMotion === '1';
  const wide = window.matchMedia('(min-width: 1024px)');

  if (body && !reduced && wide.matches) {
    const lines: { t: string; c: string }[] = JSON.parse(
      body.getAttribute('data-lines') ?? '[]',
    );
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
    const cursor = document.createElement('span');
    cursor.className =
      'inline-block h-[1.05em] w-[0.55em] translate-y-[2px] bg-[var(--color-accent)]';
    cursor.setAttribute('aria-hidden', 'true');
    let stopped = false;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    async function play() {
      while (!stopped) {
        const code = document.createElement('code');
        body!.replaceChildren(code, cursor);
        for (const line of lines) {
          if (stopped) return;
          const span = document.createElement('span');
          if (line.c) span.className = classFor(line.c);
          code.appendChild(span);
          code.appendChild(document.createTextNode('\n'));
          if (line.t === '') {
            span.innerHTML = '&nbsp;';
            continue;
          }
          for (let i = 0; i <= line.t.length; i++) {
            if (stopped) return;
            span.innerHTML = esc(line.t.slice(0, i));
            code.appendChild(cursor);
            await sleep(9);
          }
          await sleep(120);
        }
        await sleep(2500);
      }
    }

    function classFor(cls: string): string {
      switch (cls) {
        case 'accent': return 'text-[var(--color-accent)]';
        case 'muted': return 'text-[var(--color-muted)]';
        case 'faint': return 'text-[var(--color-faint)]';
        case 'critical': return 'font-semibold text-[var(--color-critical)]';
        case 'high': return 'font-semibold text-[var(--color-high)]';
        case 'ok': return 'text-[var(--color-ok)]';
        default: return 'text-[var(--color-fg)]';
      }
    }

    play();
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopped = true;
      } else {
        stopped = false;
        play();
      }
    });
  }
</script>
