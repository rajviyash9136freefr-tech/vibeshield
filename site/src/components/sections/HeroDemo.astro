---
/**
 * Professional Light Terminal — East Bay & Rum Swizzle
 * Static, high-contrast, zero-delay terminal display showing VibeShield
 * detecting hallucinated packages and leaked secrets with instant atomic fixes.
 */
---

<div
  class="overflow-hidden rounded-2xl border border-[rgba(71,76,128,0.22)] bg-white shadow-[0_8px_30px_rgba(71,76,128,0.08)]"
  role="region"
  aria-label="VibeShield Terminal Audit Preview"
>
  <!-- Window Control Bar -->
  <div class="flex items-center justify-between border-b border-[rgba(71,76,128,0.12)] px-4 py-3 bg-[#faf9f0]">
    <div class="flex items-center gap-2">
      <span class="h-3 w-3 rounded-full border border-[rgba(71,76,128,0.25)] bg-[rgba(71,76,128,0.15)]" aria-hidden="true"></span>
      <span class="h-3 w-3 rounded-full border border-[rgba(71,76,128,0.25)] bg-[rgba(71,76,128,0.15)]" aria-hidden="true"></span>
      <span class="h-3 w-3 rounded-full border border-[rgba(71,76,128,0.25)] bg-[rgba(71,76,128,0.15)]" aria-hidden="true"></span>
      <span class="ml-2 font-mono text-xs font-semibold text-[#474c80]">terminal — vibeshield scan</span>
    </div>
    <div class="flex items-center gap-1.5 font-mono text-[11px] font-bold text-[#474c80] bg-white border border-[rgba(71,76,128,0.18)] px-2 py-0.5 rounded-full">
      <span>LOCAL AUDIT</span>
    </div>
  </div>

  <!-- Terminal Body: Clean Static Text -->
  <div class="p-5 font-mono text-xs sm:text-[13px] leading-[1.75] text-[#474c80]">
    <div class="flex items-center gap-2 font-bold text-[#474c80]">
      <span class="text-[#474c80]/60">$</span>
      <span>vibeshield scan .</span>
    </div>
    <div class="mt-1 text-[#474c80]/70">
      Scanning 18 files (staged diff mode)… done in 0.38s
    </div>

    <div class="mt-4 rounded-lg border border-[rgba(185,28,28,0.2)] bg-[#fff5f5] p-3 text-[#b91c1c]">
      <div class="font-bold flex items-center justify-between">
        <span>CRITICAL · VS-PKG-001</span>
        <span class="text-[11px] uppercase tracking-wide">Hallucinated Package</span>
      </div>
      <div class="mt-1 text-xs text-[#474c80]">
        package.json:14 — <span class="font-bold text-[#b91c1c]">fast-parse-utils-v3</span> (package does not exist)
      </div>
      <div class="mt-1 font-semibold text-xs text-[#15803d]">
        → Fix: replace with native node:util (zero extra dependencies).
      </div>
    </div>

    <div class="mt-3 rounded-lg border border-[rgba(194,65,12,0.2)] bg-[#fffaf0] p-3 text-[#c2410c]">
      <div class="font-bold flex items-center justify-between">
        <span>HIGH · VS-SEC-017</span>
        <span class="text-[11px] uppercase tracking-wide">Hardcoded Secret</span>
      </div>
      <div class="mt-1 text-xs text-[#474c80]">
        src/agent.ts:42 — <span class="font-bold text-[#c2410c]">OPENAI_API_KEY</span> pasted directly from chat context
      </div>
      <div class="mt-1 font-semibold text-xs text-[#15803d]">
        → Fix: read from process.env.OPENAI_API_KEY and rotate key.
      </div>
    </div>

    <div class="mt-4 pt-3 border-t border-[rgba(71,76,128,0.12)] flex items-center justify-between text-xs font-semibold text-[#15803d]">
      <span>✓ 16 files clean · 2 atomic fixes generated</span>
      <span class="text-[#474c80]/60 font-normal">0 leaks merged</span>
    </div>
  </div>
</div>
