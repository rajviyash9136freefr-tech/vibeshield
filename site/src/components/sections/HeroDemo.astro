---
/**
 * Terminal audit preview on cream surface card.
 * Uses strict tokens without hardcoded colors or animations.
 */
---

<div
  class="overflow-hidden rounded-xl"
  style="background: var(--surface); color: var(--ink); border: 1px solid var(--border-on-ink);"
  role="region"
  aria-label="VibeShield Terminal Audit Preview"
>
  <!-- Window Control Bar -->
  <div class="flex items-center justify-between px-4 py-3" style="background: var(--bg); border-bottom: 1px solid var(--border);">
    <div class="flex items-center gap-2">
      <span class="h-3 w-3 rounded-full" style="background: color-mix(in srgb, var(--ink) 25%, transparent)" aria-hidden="true"></span>
      <span class="h-3 w-3 rounded-full" style="background: color-mix(in srgb, var(--ink) 25%, transparent)" aria-hidden="true"></span>
      <span class="h-3 w-3 rounded-full" style="background: color-mix(in srgb, var(--ink) 25%, transparent)" aria-hidden="true"></span>
      <span class="ml-2 font-mono text-xs font-semibold" style="color: var(--ink)">terminal — vibeshield scan .</span>
    </div>
    <div
      class="font-mono text-[11px] font-bold px-2 py-0.5 rounded-full"
      style="color: var(--ink); background: var(--surface); border: 1px solid var(--border);"
    >
      <span>LOCAL AUDIT</span>
    </div>
  </div>

  <!-- Terminal Body: Clean Static Text -->
  <div class="p-5 font-mono text-xs sm:text-[13px] leading-[1.75]" style="color: var(--ink)">
    <div class="flex items-center gap-2 font-bold">
      <span style="color: var(--ink-soft)">$</span>
      <span>vibeshield scan .</span>
    </div>
    <div class="mt-1" style="color: var(--ink-soft)">
      Scanning 18 files (staged diff mode)… done in 0.38s
    </div>

    <div
      class="mt-4 rounded-lg p-3"
      style="border: 1px solid var(--danger); background: color-mix(in srgb, var(--danger) 8%, var(--surface)); color: var(--danger);"
    >
      <div class="font-bold flex items-center justify-between">
        <span>CRITICAL · VS-PKG-001</span>
        <span class="text-[11px] uppercase tracking-wide">Hallucinated Package</span>
      </div>
      <div class="mt-1 text-xs" style="color: var(--ink)">
        package.json:14 — <span class="font-bold" style="color: var(--danger)">fast-parse-utils-v3</span> (package does not exist in registry)
      </div>
      <div class="mt-1 font-semibold text-xs" style="color: var(--ok)">
        → Fix: replace with native node:util (zero extra dependencies).
      </div>
    </div>

    <div
      class="mt-3 rounded-lg p-3"
      style="border: 1px solid var(--warn); background: color-mix(in srgb, var(--warn) 8%, var(--surface)); color: var(--warn);"
    >
      <div class="font-bold flex items-center justify-between">
        <span>HIGH · VS-SEC-017</span>
        <span class="text-[11px] uppercase tracking-wide">Hardcoded Secret</span>
      </div>
      <div class="mt-1 text-xs" style="color: var(--ink)">
        src/agent.ts:42 — <span class="font-bold" style="color: var(--warn)">OPENAI_API_KEY</span> pasted directly from chat context
      </div>
      <div class="mt-1 font-semibold text-xs" style="color: var(--ok)">
        → Fix: read from process.env.OPENAI_API_KEY and rotate the key now.
      </div>
    </div>

    <div
      class="mt-4 pt-3 flex items-center justify-between text-xs font-semibold"
      style="border-top: 1px solid var(--border); color: var(--ok);"
    >
      <span>✓ 16 files clean · 2 atomic fixes generated</span>
      <span class="font-normal" style="color: var(--ink-soft)">0 leaks merged</span>
    </div>
  </div>
</div>
