---
/**
 * Hero demo (UIUX §3.2): a monospace terminal card that "types" a VibeCheck
 * run. Signature motion = the only looping animation.
 * Recreated with Apple Pro obsidian glass & stark titanium monochrome syntax.
 */
import { DEMO_LINES } from '../../data/site';

function lineClass(cls: string): string {
  switch (cls) {
    case 'accent': return 'text-white font-bold';
    case 'muted': return 'text-white/65';
    case 'faint': return 'text-white/40';
    case 'critical': return 'font-bold text-black bg-white px-1 rounded';
    case 'high': return 'font-bold text-white bg-white/20 border border-white/30 px-1 rounded';
    case 'ok': return 'text-white font-medium';
    case 'fg': return 'text-white/90';
    default: return 'text-white/80';
  }
}
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const initialHtml = DEMO_LINES.map(
  (l) => `<span class="${lineClass(l.cls)}">${esc(l.text) || '&nbsp;'}</span>`,
).join('\n');
---

<div
  class="card overflow-hidden rounded-2xl border border-white/15 bg-gradient-to-b from-[#0c0c10] to-[#040406] shadow-[0_20px_50px_-15px_rgba(0,0,0,0.9)]"
  data-tilt="5"
  data-tilt-hero
  role="img"
  aria-label="Terminal showing a VibeShield scan: one critical hallucinated-package finding and one high hardcoded-secret finding, 11 files clean"
>
  <!-- Window Control Bar -->
  <div class="flex items-center justify-between border-b border-white/10 px-4 py-3 bg-white/[0.02]">
    <div class="flex items-center gap-2">
      <span class="h-2.5 w-2.5 rounded-full bg-white/30" aria-hidden="true"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-white/20" aria-hidden="true"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-white/10" aria-hidden="true"></span>
      <span class="ml-2 font-mono text-xs text-white/50">bash — vibeshield scan</span>
    </div>
    <div class="flex items-center gap-1.5 font-mono text-xs text-white/50">
      <span class="h-1.5 w-1.5 rounded-full bg-white animate-pulse"></span>
      <span>READY</span>
    </div>
  </div>

  <pre
    id="demo-body"
    class="min-h-[330px] overflow-hidden p-5 font-mono text-xs sm:text-sm leading-[1.7] text-white/85 whitespace-pre-wrap break-words sm:min-h-[340px]"
    data-lines={JSON.stringify(DEMO_LINES.map((l) => ({ t: l.text, c: l.cls })))}
  ><code set:html={initialHtml} /></pre>
</div>

<script>
  const body = document.getElementById('demo-body');
  const reduced = document.documentElement.dataset.reducedMotion === '1';
  const wide = window.matchMedia('(min-width: 1024px)');

  if (body && !reduced && wide.matches) {
    const lines: { t: string; c: string }[] = JSON.parse(
      body.getAttribute('data-lines') ?? '[]',
    );
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
    const cursor = document.createElement('span');
    cursor.className =
      'inline-block h-[1.1em] w-[0.55em] translate-y-[2px] bg-white shadow-[0_0_8px_#ffffff]';
    cursor.setAttribute('aria-hidden', 'true');
    let stopped = false;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    async function play() {
      while (!stopped) {
        const code = document.createElement('code');
        body!.replaceChildren(code, cursor);
        for (const line of lines) {
          if (stopped) return;
          const span = document.createElement('span');
          if (line.c) span.className = classFor(line.c);
          code.appendChild(span);
          code.appendChild(document.createTextNode('\n'));
          if (line.t === '') {
            span.innerHTML = '&nbsp;';
            continue;
          }
          for (let i = 0; i <= line.t.length; i++) {
            if (stopped) return;
            span.innerHTML = esc(line.t.slice(0, i));
            code.appendChild(cursor);
            await sleep(9);
          }
          await sleep(120);
        }
        await sleep(2600);
      }
    }

    function classFor(cls: string): string {
      switch (cls) {
        case 'accent': return 'text-white font-bold';
        case 'muted': return 'text-white/65';
        case 'faint': return 'text-white/40';
        case 'critical': return 'font-bold text-black bg-white px-1 rounded';
        case 'high': return 'font-bold text-white bg-white/20 border border-white/30 px-1 rounded';
        case 'ok': return 'text-white font-medium';
        default: return 'text-white/85';
      }
    }

    play();
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopped = true;
      } else {
        stopped = false;
        play();
      }
    });
  }
</script>
