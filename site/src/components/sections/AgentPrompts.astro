---
import { AGENT_PROMPTS } from '../../data/site';
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
---

<section id="agents" class="section relative" style="background: var(--bg); border-top: 1px solid var(--border);">
  <div class="wrap">
    <!-- Header -->
    <div class="max-w-2xl">
      <div
        class="inline-flex items-center gap-2 rounded-full px-3 py-1 mb-3"
        style="border: 1px solid var(--border); background: var(--surface);"
      >
        <span class="h-2 w-2 rounded-full" style="background: var(--ink)"></span>
        <span class="eyebrow" style="color: var(--ink)">
          Agent Rules &amp; Prompts
        </span>
      </div>
      <h2 style="color: var(--ink)">
        Adversarial Guardrails for Your AI Coding Agent
      </h2>
      <p class="mt-3 text-base sm:text-lg font-sans" style="color: var(--ink-soft)">
        Select your AI coding tool below to copy pre-tuned rule prompts that force the agent to audit dependencies, ban leaked keys, and verify diffs before suggesting code.
      </p>
    </div>

    <!-- Agent Selector Tabs -->
    <div class="mt-10" data-agent-hub>
      <div class="flex flex-wrap items-center gap-2.5 pb-5" style="border-bottom: 1px solid var(--border)" role="tablist">
        {AGENT_PROMPTS.map((agent, i) => (
          <button
            type="button"
            role="tab"
            id={`agent-tab-${agent.id}`}
            data-agent-id={agent.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`agent-panel-${agent.id}`}
            tabindex={i === 0 ? '0' : '-1'}
            class="agent-btn flex items-center gap-2 rounded-full px-4 py-2 text-xs sm:text-sm font-semibold transition-colors duration-150 font-display"
            style={i === 0 ? 'background: var(--ink); color: var(--on-ink); border: 1px solid var(--ink);' : 'background: var(--surface); color: var(--ink); border: 1px solid var(--border);'}
          >
            <span class="tab-label">{agent.name}</span>
            <span
              class="tab-badge rounded px-1.5 py-0.5 text-[10px] font-mono uppercase"
              style={i === 0 ? 'background: color-mix(in srgb, var(--on-ink) 20%, transparent); color: var(--on-ink);' : 'background: var(--bg); color: var(--ink-soft);'}
            >
              {agent.badge}
            </span>
          </button>
        ))}
      </div>

      <!-- Tab Panels -->
      <div class="mt-6">
        {AGENT_PROMPTS.map((agent, i) => (
          <div
            role="tabpanel"
            id={`agent-panel-${agent.id}`}
            aria-labelledby={`agent-tab-${agent.id}`}
            hidden={i !== 0}
            class="agent-panel card p-6 sm:p-8"
            style="background: var(--surface); border: 1px solid var(--border);"
          >
            <!-- Top Meta Info -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6" style="border-bottom: 1px solid var(--border)">
              <div>
                <div class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full" style="background: var(--ink)"></span>
                  <h3 class="text-xl font-bold tracking-tight font-display" style="color: var(--ink)">{agent.name} Guardrail Configuration</h3>
                </div>
                <p class="mt-1.5 text-xs sm:text-sm font-sans" style="color: var(--ink-soft)">
                  {agent.description}
                </p>
              </div>
              <div class="shrink-0 flex items-center gap-2">
                <span class="font-mono text-xs font-semibold" style="color: var(--ink-soft)">Config File:</span>
                <span
                  class="rounded-lg px-3 py-1 font-mono text-xs font-bold"
                  style="border: 1px solid var(--border); background: var(--bg); color: var(--ink);"
                >
                  {agent.filename}
                </span>
              </div>
            </div>

            <!-- Optional CLI Command -->
            {agent.cliCommand && (
              <div class="mt-6">
                <div class="flex items-center justify-between mb-2">
                  <span class="eyebrow" style="color: var(--ink)">
                    Terminal Command
                  </span>
                  <button
                    type="button"
                    class="copy-btn inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-mono text-xs font-bold transition-colors"
                    style="border: 1px solid var(--border); background: var(--bg); color: var(--ink);"
                    data-copy-target={`cli-${agent.id}`}
                  >
                    <span>Copy Command</span>
                  </button>
                </div>
                <pre
                  id={`cli-${agent.id}`}
                  class="scroll-x rounded-xl p-4 font-mono text-xs font-semibold leading-relaxed overflow-x-auto"
                  style="border: 1px solid var(--border); background: var(--bg); color: var(--ink);"
                ><code>{agent.cliCommand}</code></pre>
              </div>
            )}

            <!-- Copyable Prompt Block -->
            <div class="mt-6">
              <div class="flex items-center justify-between mb-2">
                <span class="eyebrow" style="color: var(--ink)">
                  Adversarial Prompt Content
                </span>
                <button
                  type="button"
                  class="copy-btn inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 font-mono text-xs font-bold transition-colors"
                  style="background: var(--ink); color: var(--on-ink);"
                  data-copy-target={`prompt-${agent.id}`}
                >
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span class="btn-text">Copy Prompt</span>
                </button>
              </div>

              <pre
                id={`prompt-${agent.id}`}
                class="scroll-x rounded-xl p-5 sm:p-6 font-mono text-xs sm:text-[13px] leading-relaxed overflow-x-auto"
                style="border: 1px solid var(--border); background: var(--bg); color: var(--ink);"
              ><code set:html={esc(agent.prompt)} /></pre>
            </div>

            <!-- Footer Action Strip -->
            <div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-4 text-xs font-mono" style="border-top: 1px solid var(--border); color: var(--ink-soft)">
              <div class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full" style="background: var(--ok)"></span>
                <span class="font-sans font-semibold">Paste directly into your repository</span>
              </div>
              <a
                href="https://github.com/rajviyash9136freefr-tech/vibeshield"
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold hover:underline flex items-center gap-1 font-sans"
                style="color: var(--ink)"
              >
                <span>View rule configs on GitHub</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const hub = document.querySelector('[data-agent-hub]');
  if (hub) {
    const tabs = [...hub.querySelectorAll<HTMLButtonElement>('.agent-btn')];
    const panels = [...hub.querySelectorAll<HTMLElement>('.agent-panel')];

    function selectAgent(index: number) {
      tabs.forEach((tab, i) => {
        const isSelected = i === index;
        tab.setAttribute('aria-selected', String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;
        if (isSelected) {
          tab.style.background = 'var(--ink)';
          tab.style.color = 'var(--on-ink)';
          tab.style.borderColor = 'var(--ink)';
          const badge = tab.querySelector<HTMLElement>('.tab-badge');
          if (badge) {
            badge.style.background = 'color-mix(in srgb, var(--on-ink) 20%, transparent)';
            badge.style.color = 'var(--on-ink)';
          }
        } else {
          tab.style.background = 'var(--surface)';
          tab.style.color = 'var(--ink)';
          tab.style.borderColor = 'var(--border)';
          const badge = tab.querySelector<HTMLElement>('.tab-badge');
          if (badge) {
            badge.style.background = 'var(--bg)';
            badge.style.color = 'var(--ink-soft)';
          }
        }
      });

      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => selectAgent(i));
    });

    hub.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const targetId = btn.dataset.copyTarget;
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        if (!targetEl) return;

        const text = targetEl.textContent || '';
        try {
          await navigator.clipboard.writeText(text);
          const originalContent = btn.innerHTML;
          btn.innerHTML = '<span>✓ Copied!</span>';
          setTimeout(() => {
            btn.innerHTML = originalContent;
          }, 2000);
        } catch (err) {
          console.error('Copy failed', err);
        }
      });
    });
  }
</script>
