---
import { AGENT_PROMPTS } from '../../data/site';
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
---

<section id="agents" class="section border-t border-white/10 relative bg-gradient-to-b from-black via-[#070709] to-black">
  <div class="wrap">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto" data-reveal>
      <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 backdrop-blur-md mb-4">
        <span class="h-1.5 w-1.5 rounded-full bg-white animate-pulse"></span>
        <span class="font-mono text-xs font-medium tracking-wider text-white/80 uppercase">
          Agent Rules & Prompts
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-[-0.035em] text-apple-headline">
        Set Up VibeShield for Your AI Agent
      </h2>
      <p class="mt-4 text-base sm:text-lg text-white/65 leading-relaxed">
        Select your coding agent below to copy the ready-to-use rule prompt, install the skill, or set up manual verification in one click.
      </p>
    </div>

    <!-- Agent Selector Tabs -->
    <div class="mt-12 max-w-4xl mx-auto" data-agent-hub data-reveal>
      <div class="flex flex-wrap items-center justify-center gap-2 border-b border-white/10 pb-4" role="tablist">
        {AGENT_PROMPTS.map((agent, i) => (
          <button
            type="button"
            role="tab"
            id={`agent-tab-${agent.id}`}
            data-agent-id={agent.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`agent-panel-${agent.id}`}
            tabindex={i === 0 ? '0' : '-1'}
            class="agent-btn group flex items-center gap-2.5 rounded-full px-4 sm:px-5 py-2 sm:py-2.5 text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer"
          >
            <span class="tab-label transition-colors duration-150">{agent.name}</span>
            <span class="tab-badge rounded px-1.5 py-0.5 text-[10px] font-mono uppercase tracking-wider transition-colors duration-150">{agent.badge}</span>
          </button>
        ))}
      </div>

      <!-- Tab Panels -->
      <div class="mt-6">
        {AGENT_PROMPTS.map((agent, i) => (
          <div
            role="tabpanel"
            id={`agent-panel-${agent.id}`}
            aria-labelledby={`agent-tab-${agent.id}`}
            hidden={i !== 0}
            class="agent-panel card rounded-3xl border border-white/15 bg-[#09090c] p-6 sm:p-8 shadow-2xl transition-all duration-300"
          >
            <!-- Top Meta Info -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-6">
              <div>
                <div class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-white shadow-[0_0_8px_rgba(255,255,255,0.8)]"></span>
                  <h3 class="text-xl font-bold text-white tracking-tight">{agent.name} Setup Guide</h3>
                </div>
                <p class="mt-1.5 text-xs sm:text-sm text-white/60">
                  {agent.description}
                </p>
              </div>
              <div class="shrink-0 flex items-center gap-2">
                <span class="font-mono text-xs text-white/40">Target:</span>
                <span class="rounded-lg border border-white/20 bg-white/10 px-2.5 py-1 font-mono text-xs font-semibold text-white">
                  {agent.filename}
                </span>
              </div>
            </div>

            <!-- Optional CLI Command (e.g. for Claude Code marketplace) -->
            {agent.cliCommand && (
              <div class="mt-6">
                <div class="flex items-center justify-between mb-2">
                  <span class="font-mono text-xs font-semibold uppercase tracking-wider text-white/60">
                    Terminal Quick Command
                  </span>
                  <button
                    type="button"
                    class="copy-btn inline-flex items-center gap-1.5 rounded-full border border-white/20 bg-white/10 px-3 py-1 font-mono text-xs text-white transition-all hover:bg-white hover:text-black active:scale-95"
                    data-copy-target={`cli-${agent.id}`}
                  >
                    <span>Copy Command</span>
                  </button>
                </div>
                <pre
                  id={`cli-${agent.id}`}
                  class="scroll-x rounded-xl border border-white/10 bg-black/90 p-4 font-mono text-xs text-white/90 leading-relaxed overflow-x-auto"
                ><code>{agent.cliCommand}</code></pre>
              </div>
            )}

            <!-- Copyable Prompt Block -->
            <div class="mt-6">
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-xs font-semibold uppercase tracking-wider text-white/60">
                  Agent Rule Prompt
                </span>
                <button
                  type="button"
                  class="copy-btn inline-flex items-center gap-1.5 rounded-full border border-white bg-white text-black px-4 py-1.5 font-mono text-xs font-bold transition-all shadow-[0_0_15px_rgba(255,255,255,0.2)] hover:bg-white/90 active:scale-95"
                  data-copy-target={`prompt-${agent.id}`}
                >
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span class="btn-text">Copy Prompt</span>
                </button>
              </div>

              <pre
                id={`prompt-${agent.id}`}
                class="scroll-x rounded-2xl border border-white/15 bg-black/90 p-5 sm:p-6 font-mono text-xs sm:text-sm leading-relaxed text-white/85 shadow-inner overflow-x-auto"
              ><code set:html={esc(agent.prompt)} /></pre>
            </div>

            <!-- Footer Action Strip -->
            <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-4 text-xs text-white/50 font-mono">
              <div class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-white/70"></span>
                <span>Ready to paste directly into your agent</span>
              </div>
              <a
                href="https://github.com/rajviyash9136freefr-tech/vibeshield"
                target="_blank"
                rel="noopener noreferrer"
                class="text-white hover:underline flex items-center gap-1 font-sans"
              >
                <span>View skill files on GitHub</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Unselected State (Default) */
  .agent-btn[aria-selected="false"] {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.75);
  }
  .agent-btn[aria-selected="false"] .tab-label {
    color: rgba(255, 255, 255, 0.75);
  }
  .agent-btn[aria-selected="false"] .tab-badge {
    background-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.6);
  }
  .agent-btn[aria-selected="false"]:hover {
    border-color: rgba(255, 255, 255, 0.35);
    background-color: rgba(255, 255, 255, 0.08);
  }
  .agent-btn[aria-selected="false"]:hover .tab-label {
    color: #ffffff;
  }
  .agent-btn[aria-selected="false"]:hover .tab-badge {
    color: rgba(255, 255, 255, 0.95);
    background-color: rgba(255, 255, 255, 0.16);
  }

  /* Selected / Active State — 100% High Contrast on ALL tools (Cursor, Claude Code, Windsurf, Copilot, Terminal) */
  .agent-btn[aria-selected="true"] {
    background-color: #ffffff !important;
    border: 1px solid #ffffff !important;
    color: #000000 !important;
    box-shadow: 0 0 25px rgba(255, 255, 255, 0.28) !important;
  }
  .agent-btn[aria-selected="true"] .tab-label {
    color: #000000 !important;
    font-weight: 700 !important;
  }
  .agent-btn[aria-selected="true"] .tab-badge {
    background-color: rgba(0, 0, 0, 0.14) !important;
    color: #000000 !important;
    font-weight: 700 !important;
  }
</style>

<script>
  // Agent Prompts Tab Switcher
  const hub = document.querySelector('[data-agent-hub]');
  if (hub) {
    const tabs = [...hub.querySelectorAll<HTMLButtonElement>('.agent-btn')];
    const panels = [...hub.querySelectorAll<HTMLElement>('.agent-panel')];

    function selectAgent(index: number) {
      tabs.forEach((tab, i) => {
        const isSelected = i === index;
        tab.setAttribute('aria-selected', String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;
      });

      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => selectAgent(i));
    });

    // Copy Prompt functionality with visual feedback
    hub.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const targetId = btn.dataset.copyTarget;
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        if (!targetEl) return;

        const text = targetEl.textContent || '';
        try {
          await navigator.clipboard.writeText(text);
          const originalContent = btn.innerHTML;
          btn.innerHTML = '<span>✓ Copied!</span>';
          btn.classList.add('bg-white', 'text-black');
          setTimeout(() => {
            btn.innerHTML = originalContent;
            btn.classList.remove('bg-white', 'text-black');
          }, 2000);
        } catch (err) {
          console.error('Copy failed', err);
        }
      });
    });
  }
</script>
