---
import { COMPARISON } from '../../data/site';
---

<section class="section border-t border-white/10 relative">
  <div class="wrap" data-reveal>
    <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1 backdrop-blur-md mb-4">
      <span class="font-mono text-[11px] font-medium tracking-wider text-white/70 uppercase">
        Capability Matrix
      </span>
    </div>
    <h2 class="scroll-tell text-[32px] font-bold tracking-[-0.035em] text-apple-headline sm:text-[42px] lg:text-[48px]">
      {COMPARISON.h2}
    </h2>

    <div class="scroll-x fade-x mt-10 overflow-x-auto rounded-2xl border border-white/15 bg-gradient-to-b from-[#0e0e12] to-[#040406] shadow-2xl">
      <table class="w-full min-w-[720px] border-collapse text-sm">
        <thead>
          <tr class="border-b border-white/10 bg-white/[0.03] text-left">
            <th scope="col" class="sticky left-0 z-10 min-w-52 bg-[#0c0c10] px-5 py-4 font-semibold text-white">Capability</th>
            {COMPARISON.cols.map((c) => (
              <th scope="col" class={`min-w-28 px-5 py-4 font-semibold ${c === 'VibeShield' ? 'text-white bg-white/10' : 'text-white/50'}`}>
                {c}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {COMPARISON.rows.map((r) => (
            <tr class="border-b border-white/5 last:border-0 hover:bg-white/[0.02] transition-colors">
              <th scope="row" class="sticky left-0 z-10 bg-[#070709] px-5 py-3.5 text-left font-medium text-white/90">{r.label}</th>
              {r.vals.map((v, i) => (
                <td class={`px-5 py-3.5 font-mono text-center ${i === r.vals.length - 1 ? 'bg-white/[0.07] font-semibold text-white' : 'text-white/60'}`} data-sev={v === '✅' ? 'ok' : v === '❌' ? 'no' : 'warn'}>
                  {v}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-xs font-mono text-white/40">
      ⚠️ = partial or paid-only. Data from public docs, Sep 2026. VibeShield is MIT-licensed and complements Dependabot.
    </p>
  </div>
</section>

<style>
  [data-sev='ok'] { color: #ffffff; }
  [data-sev='no'] { color: rgba(255, 255, 255, 0.35); }
  [data-sev='warn'] { color: rgba(255, 255, 255, 0.65); }
</style>
