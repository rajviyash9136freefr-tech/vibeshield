---
import { baseHref } from '../../lib/base';
---

<section class="border-t border-white/10 relative overflow-hidden bg-gradient-to-b from-black via-[#0a0a0d] to-black">
  <!-- Apple ambient specular glow -->
  <div
    class="pointer-events-none absolute inset-x-0 top-1/2 -translate-y-1/2 h-[500px] opacity-60"
    style="background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(255, 255, 255, 0.06) 0%, rgba(0, 0, 0, 0) 100%);"
    aria-hidden="true"
  ></div>

  <div class="wrap section !py-28 text-center relative" data-reveal>
    <!-- 3D shield rotates into plane as the section scrolls into view -->
    <div class="flex justify-center mb-7">
      <div class="flex h-16 w-16 items-center justify-center rounded-2xl border border-white/20 bg-white/5 shadow-[0_0_30px_rgba(255,255,255,0.1)] backdrop-blur-md">
        <svg class="shield-3d" width="36" height="36" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 2 4 5.5V11c0 5 3.2 8.9 8 10.5 4.8-1.6 8-5.5 8-10.5V5.5L12 2Z"
            stroke="#ffffff"
            stroke-width="1.8"
            fill="rgba(255, 255, 255, 0.12)"
          />
          <path
            d="m8.5 11.8 2.4 2.4 4.6-4.9"
            stroke="#ffffff"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    </div>

    <h2 class="mx-auto max-w-[24ch] text-3xl font-bold leading-tight tracking-[-0.035em] text-apple-headline sm:text-4xl lg:text-5xl">
      Stop AI Bugs & Hallucinations Before They Merge.
    </h2>
    <p class="mt-4 text-base text-white/65 sm:text-lg">
      Test your vibe-coded apps in under 1.2s. 100% offline, local static analysis, and zero data leaves your machine.
    </p>

    <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
      <a
        href={baseHref('/#agents')}
        class="btn-primary flex items-center gap-2"
      >
        <span>Get Agent Prompts</span>
        <span>↓</span>
      </a>
      <a
        href={baseHref('/#install')}
        class="btn-secondary"
      >
        How to Install
      </a>
      <a
        href="https://github.com/rajviyash9136freefr-tech/vibeshield"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-white/15 bg-white/5 px-5 py-2 text-xs font-semibold text-white/80 hover:border-white/30 hover:bg-white/10 hover:text-white transition-all flex items-center gap-1.5"
      >
        <span>★ Star on GitHub</span>
      </a>
    </div>

    <p class="mt-6 text-xs font-mono text-white/40">
      MIT Licensed · 100% Free · No credit card · No user data stored
    </p>
  </div>
</section>
