---
// §3.11 — full-width accent-dim wash band.
---

<section class="border-t border-[var(--color-hairline)]" style="background: linear-gradient(180deg, rgba(45,212,191,0.06), rgba(45,212,191,0.02));">
  <div class="wrap section !py-24 text-center">
    <h2 class="mx-auto max-w-[24ch] text-[28px] font-bold leading-tight tracking-[-0.02em] lg:text-[40px]">
      Ship AI code like you'd ship a teammate's.
    </h2>
    <p class="mt-4 text-[17px] text-[var(--color-muted)]">
      One YAML file. Three minutes. Zero secrets in <code class="font-mono text-[15px] text-[var(--color-fg)]">main</code>.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a href="/#install" class="rounded-[var(--radius-btn)] bg-[var(--color-accent-strong)] px-6 py-3 font-semibold text-[#06231f] transition-transform duration-150 hover:-translate-y-px">Install free</a>
      <a href="/docs" class="rounded-[var(--radius-btn)] border border-[var(--color-hairline)] px-6 py-3 font-medium hover:border-[var(--color-accent)]">Read the docs →</a>
    </div>
  </div>
</section>
