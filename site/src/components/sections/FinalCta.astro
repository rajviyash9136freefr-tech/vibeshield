---
import { baseHref } from '../../lib/base';
import { SITE } from '../../data/site';
---

<section class="border-t border-[rgba(71,76,128,0.15)] relative bg-[#f8f7e2] py-20 lg:py-28">
  <div class="wrap text-center relative max-w-3xl mx-auto">
    <!-- Brand Shield Icon -->
    <div class="flex justify-center mb-6">
      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[#474c80] text-[#f8f7e2] shadow-sm">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 2 4 5.5V11c0 5 3.2 8.9 8 10.5 4.8-1.6 8-5.5 8-10.5V5.5L12 2Z"
            stroke="#f8f7e2"
            stroke-width="2"
            fill="none"
          />
          <path
            d="m8.5 11.8 2.4 2.4 4.6-4.9"
            stroke="#f8f7e2"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    </div>

    <h2 class="text-3xl font-extrabold leading-tight tracking-[-0.03em] text-[#474c80] sm:text-4xl lg:text-5xl font-display">
      Stop Insecure AI Code Before It Ever Merges to Main.
    </h2>
    <p class="mt-4 text-base text-[#474c80]/80 sm:text-lg font-sans">
      Audit your vibe-coded apps in under 1 second. 100% offline, local static binary analysis, with zero code or tokens sent to external servers.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
      <a
        href={baseHref('/#install')}
        class="btn-primary"
      >
        Install VibeShield Free
      </a>
      <a
        href={baseHref('/#agents')}
        class="btn-secondary"
      >
        Copy Agent Guardrails
      </a>
      <a
        href={SITE.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-full border border-[rgba(71,76,128,0.25)] bg-white px-5 py-3 text-xs font-bold text-[#474c80] hover:border-[#474c80] transition-colors shadow-sm font-display"
      >
        <span>★ Star on GitHub</span>
      </a>
    </div>

    <p class="mt-6 text-xs font-semibold text-[#474c80]/60">
      MIT Licensed · 100% Free · No account required · Open Source
    </p>
  </div>
</section>
