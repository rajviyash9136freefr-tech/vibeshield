---
import { baseHref } from '../../lib/base';
import { SITE } from '../../data/site';
---

<section
  class="relative py-20 lg:py-28"
  style="background-color: var(--ink); color: var(--on-ink); border-top: 1px solid var(--border);"
>
  <div class="wrap text-center relative max-w-3xl mx-auto">
    <!-- Brand Shield Icon in Cream Surface -->
    <div class="flex justify-center mb-6">
      <div
        class="flex h-16 w-16 items-center justify-center rounded-xl"
        style="background: var(--surface); color: var(--ink); border: 1px solid var(--border-on-ink);"
      >
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 2 4 5.5V11c0 5 3.2 8.9 8 10.5 4.8-1.6 8-5.5 8-10.5V5.5L12 2Z"
            stroke="currentColor"
            stroke-width="2"
            fill="none"
          />
          <path
            d="m8.5 11.8 2.4 2.4 4.6-4.9"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    </div>

    <h2 class="uppercase tracking-tight" style="color: var(--on-ink)">
      Audit Your AI Code Before It Enters Production
    </h2>
    <p class="mt-4 text-base sm:text-lg font-sans" style="color: var(--on-ink-soft)">
      Scan local git diffs in under 1 second. 100% offline static binary analysis with zero code or tokens sent to external servers.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
      <a
        href={baseHref('/#install')}
        class="btn-on-ink"
      >
        Download VibeShield
      </a>
      <a
        href={baseHref('/#agents')}
        class="btn-secondary-on-ink"
      >
        Copy Agent Guardrails
      </a>
      <a
        href={SITE.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-full px-5 py-3 text-xs font-bold font-display transition-colors"
        style="border: 1px solid var(--border-on-ink); color: var(--on-ink);"
      >
        <span>★ Star on GitHub</span>
      </a>
    </div>

    <p class="mt-6 text-xs font-semibold" style="color: var(--on-ink-soft)">
      MIT Licensed · 100% Free · No account required · Open Source
    </p>
  </div>
</section>
