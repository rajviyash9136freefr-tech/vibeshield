---
// §3.11 — full-width accent-dim wash band.
import { baseHref } from '../../lib/base';
---

<section class="border-t border-[var(--color-hairline)] relative overflow-hidden" style="background: linear-gradient(180deg, rgba(45,212,191,0.06), rgba(45,212,191,0.02));">
  <div class="wrap section !py-24 text-center relative">
    <!-- 3D shield rotates into plane as the band scrolls in (CSS scroll-driven) -->
    <svg class="shield-3d mx-auto mb-6" width="44" height="44" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 2 4 5.5V11c0 5 3.2 8.9 8 10.5 4.8-1.6 8-5.5 8-10.5V5.5L12 2Z"
        stroke="var(--color-accent)" stroke-width="1.6" fill="var(--color-accent-dim)" />
      <path d="m8.5 11.8 2.4 2.4 4.6-4.9" stroke="var(--color-accent)" stroke-width="1.6"
        stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <h2 class="mx-auto max-w-[24ch] text-[28px] font-bold leading-tight tracking-[-0.02em] lg:text-[40px]">
      Ship AI code like you'd ship a teammate's.
    </h2>
    <p class="mt-4 text-[17px] text-[var(--color-muted)]">
      One YAML file. Three minutes. Zero secrets in <code class="font-mono text-[15px] text-[var(--color-fg)]">main</code>.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a href={baseHref('/#install')} class="rounded-[var(--radius-btn)] bg-[var(--color-accent-strong)] px-6 py-3 font-semibold text-[#06231f] transition-transform duration-150 hover:-translate-y-px">Install free</a>
      <a href={baseHref('/docs')} class="rounded-[var(--radius-btn)] border border-[var(--color-hairline)] px-6 py-3 font-medium hover:border-[var(--color-accent)]">Read the docs →</a>
    </div>
  </div>
</section>
