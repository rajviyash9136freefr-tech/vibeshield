---
import { SITE } from '../../data/site';
import { baseHref } from '../../lib/base';
import HeroDemo from './HeroDemo.astro';
---

<section class="relative pt-12 pb-20 lg:pt-18 lg:pb-28" style="background-color: var(--ink); color: var(--on-ink);">
  <div class="wrap grid items-center gap-12 lg:grid-cols-[minmax(0,55%)_minmax(0,45%)] lg:gap-10">
    <div>
      <!-- Eyebrow Pill -->
      <div
        class="inline-flex items-center gap-2 rounded-full px-3.5 py-1.5"
        style="border: 1px solid var(--border-on-ink); background: color-mix(in srgb, var(--on-ink) 10%, transparent);"
      >
        <span class="h-2 w-2 rounded-full" style="background: var(--on-ink)"></span>
        <span class="eyebrow" style="color: var(--on-ink)">
          AI Code Guardian · v0.3.0
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="mt-5 uppercase tracking-tight" style="color: var(--on-ink)">
        Audit AI Code for Hallucinated Packages &amp; Leaked Keys Before Merge
      </h1>

      <!-- Subtitle -->
      <p class="mt-5 max-w-[540px] text-base leading-relaxed sm:text-lg font-sans" style="color: var(--on-ink-soft)">
        VibeShield inspects local git diffs in under 1 second. Catches nonexistent npm/pip packages (slopsquatting), leaked API tokens, and insecure scaffolding patterns before they enter production.
      </p>

      <!-- Instant CLI Copy Strip -->
      <div
        class="mt-7 max-w-[520px] flex items-center justify-between rounded-xl px-4 py-3"
        style="border: 1px solid var(--border-on-ink); background: color-mix(in srgb, var(--on-ink) 8%, transparent);"
      >
        <div class="flex items-center gap-2.5 font-mono text-xs sm:text-sm truncate" style="color: var(--on-ink)">
          <span class="select-none" style="color: var(--on-ink-soft)">$</span>
          <span class="font-semibold select-all">curl -fsSL https://vibeshield.dev/install.sh | bash</span>
        </div>
        <button
          type="button"
          data-copy="curl -fsSL https://vibeshield.dev/install.sh | bash"
          class="ml-3 shrink-0 rounded-lg px-3 py-1 font-sans text-xs font-bold transition-opacity hover:opacity-90"
          style="background: var(--on-ink); color: var(--ink);"
          aria-label="Copy install command"
        >
          Copy
        </button>
      </div>

      <!-- CTA Buttons -->
      <div class="mt-8 flex flex-wrap items-center gap-3.5">
        <a
          href={baseHref('/#install')}
          class="btn-on-ink"
        >
          Download Binary
        </a>
        <a
          href={baseHref('/#scanner')}
          class="btn-secondary-on-ink"
        >
          Live Inspection Demo
        </a>
        <a
          href={SITE.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full px-4 py-3 text-xs font-bold transition-colors font-display"
          style="border: 1px solid var(--border-on-ink); color: var(--on-ink);"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A7.995 7.995 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          <span>Star on GitHub</span>
        </a>
      </div>

      <!-- Trust Strip -->
      <div class="mt-8 flex flex-wrap items-center gap-y-2 gap-x-4 text-xs font-semibold" style="color: var(--on-ink-soft)">
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4" style="color: var(--ok-on-ink)" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
          100% Local &amp; Offline
        </span>
        <span style="color: var(--border-on-ink)">·</span>
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4" style="color: var(--ok-on-ink)" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
          Zero Network Egress
        </span>
        <span style="color: var(--border-on-ink)">·</span>
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4" style="color: var(--ok-on-ink)" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
          MIT Open Source
        </span>
      </div>
    </div>

    <!-- Right: Static Terminal Card -->
    <div>
      <HeroDemo />
    </div>
  </div>
</section>
