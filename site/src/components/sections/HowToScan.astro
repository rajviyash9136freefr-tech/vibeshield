---
const commands = [
  {
    title: '1. Scan Entire Project',
    desc: 'Audit all repository files, dependency manifests, and components for hallucinated packages, leaked keys, and insecure code.',
    cmd: 'vibeshield scan .',
    badge: 'Full Audit',
  },
  {
    title: '2. Scan Git Diff Against Main',
    desc: 'Audit only the changed files from your current AI coding session before opening a pull request.',
    cmd: 'vibeshield scan --diff main',
    badge: 'PR Speed',
  },
  {
    title: '3. Scan Staged Files (Pre-Commit)',
    desc: 'Sub-second check before git commit. Blocks secrets and hallucinated imports before they enter git history.',
    cmd: 'vibeshield scan --staged',
    badge: 'Fast Hook',
  },
  {
    title: '4. Automatically Apply 1-Line Fixes',
    desc: 'Interactively preview and auto-remediate flagged hallucinated packages with verified standard library replacements.',
    cmd: 'vibeshield fix .',
    badge: 'Auto-Remediate',
  },
];
---

<section id="how-to-scan" class="section border-t border-[rgba(71,76,128,0.15)] relative bg-[#f8f7e2]">
  <div class="wrap">
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-[rgba(71,76,128,0.22)] bg-white px-3.5 py-1.5 shadow-sm mb-4">
        <span class="h-2 w-2 rounded-full bg-[#474c80]"></span>
        <span class="font-display text-xs font-bold tracking-wider text-[#474c80] uppercase">
          CLI & Workflow Guide
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-[-0.03em] text-[#474c80] font-display">
        How to Scan & Fix Insecure AI Code
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#474c80]/80 leading-relaxed font-sans">
        Run instant local audits from your terminal or inside your agent. Copy any command below to test your workspace immediately.
      </p>
    </div>

    <!-- Commands Grid -->
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {commands.map((c) => (
        <div class="card rounded-2xl border border-[rgba(71,76,128,0.2)] bg-white p-6 shadow-sm hover:border-[#474c80] transition-colors">
          <div class="flex items-center justify-between border-b border-[rgba(71,76,128,0.15)] pb-3">
            <h3 class="text-base font-bold text-[#474c80] font-display">{c.title}</h3>
            <span class="rounded-md border border-[rgba(71,76,128,0.25)] bg-[#faf9f0] px-2.5 py-0.5 font-mono text-[11px] font-bold text-[#474c80]">
              {c.badge}
            </span>
          </div>
          <p class="mt-3 text-xs sm:text-sm text-[#474c80]/75 leading-relaxed min-h-[40px] font-sans">
            {c.desc}
          </p>
          <div class="mt-4 relative">
            <pre class="scroll-x rounded-xl border border-[rgba(71,76,128,0.18)] bg-[#faf9f0] p-3.5 font-mono text-xs font-bold text-[#474c80] pr-24 overflow-x-auto"><code>{c.cmd}</code></pre>
            <button
              type="button"
              class="scan-copy-btn absolute top-2 right-2 rounded-lg border border-[rgba(71,76,128,0.25)] bg-white px-3 py-1 font-display text-xs font-bold text-[#474c80] transition-colors hover:bg-[#474c80] hover:text-[#f8f7e2]"
              data-cmd={c.cmd}
            >
              <span>Copy</span>
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Terminal Output Demonstration -->
    <div class="mt-10 rounded-2xl border border-[rgba(71,76,128,0.22)] bg-white p-5 sm:p-6 font-mono text-xs sm:text-sm shadow-sm">
      <div class="flex items-center justify-between border-b border-[rgba(71,76,128,0.15)] pb-3 mb-4">
        <div class="flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-[rgba(71,76,128,0.3)]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[rgba(71,76,128,0.3)]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[rgba(71,76,128,0.3)]"></span>
          <span class="ml-2 text-[#474c80] font-bold text-xs">Terminal Output Preview</span>
        </div>
        <span class="text-[#474c80]/70 text-xs font-semibold">Completed in 0.38s</span>
      </div>
      <div class="space-y-2.5 text-[#474c80] leading-relaxed overflow-x-auto">
        <p class="font-bold">$ vibeshield scan .</p>
        <p class="text-[#474c80]/70">&nbsp;&nbsp;Scanning 14 project files (diff mode)… done in 0.38s</p>
        
        <div class="mt-2 pl-3 border-l-2 border-[#b91c1c] space-y-1 bg-[#fff5f5] p-2.5 rounded-r-lg">
          <p class="font-bold text-[#b91c1c]"><span class="bg-[#b91c1c] text-white px-1.5 py-0.5 rounded text-[11px] font-mono font-bold mr-2">CRITICAL</span>VS-PKG-001 &nbsp;hallucinated-package</p>
          <p class="text-[#474c80]">&nbsp;&nbsp;package.json:8 — fast-parse-utils-v3@2.1.4</p>
          <p class="text-[#474c80]/75">&nbsp;&nbsp;Why: Package does not exist in registry. Slopsquatting risk.</p>
          <p class="font-semibold text-[#15803d]">&nbsp;&nbsp;→ Fix: Replace with standard library node:util (12 lines, zero dependencies).</p>
        </div>

        <div class="mt-2 pl-3 border-l-2 border-[#c2410c] space-y-1 bg-[#fffaf0] p-2.5 rounded-r-lg">
          <p class="font-bold text-[#c2410c]"><span class="bg-[#c2410c] text-white px-1.5 py-0.5 rounded text-[11px] font-mono font-bold mr-2">HIGH</span>VS-SEC-017 &nbsp;hardcoded-secret</p>
          <p class="text-[#474c80]">&nbsp;&nbsp;src/agent.ts:41 — OPENAI_API_KEY = "sk-proj-••••••••••••••4a2f"</p>
          <p class="text-[#474c80]/75">&nbsp;&nbsp;Why: Copilot pasted credentials echoed from conversation context memory.</p>
          <p class="font-semibold text-[#15803d]">&nbsp;&nbsp;→ Fix: Read from process.env.OPENAI_API_KEY and rotate the leaked key now.</p>
        </div>

        <p class="pt-2 text-[#15803d] font-bold">✓ 12 files clean · 2 findings · 0 unverified dependencies merged</p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.scan-copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const cmd = btn.dataset.cmd;
      if (!cmd) return;
      try {
        await navigator.clipboard.writeText(cmd);
        const original = btn.innerHTML;
        btn.innerHTML = '<span>✓ Copied!</span>';
        btn.classList.add('bg-[#474c80]', 'text-[#f8f7e2]');
        setTimeout(() => {
          btn.innerHTML = original;
          btn.classList.remove('bg-[#474c80]', 'text-[#f8f7e2]');
        }, 2000);
      } catch {
        btn.innerText = 'Press Ctrl+C';
      }
    });
  });
</script>
