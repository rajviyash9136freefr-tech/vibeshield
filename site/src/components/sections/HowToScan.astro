---
const commands = [
  {
    title: '1. Scan Entire Project',
    desc: 'Audit all files, manifests, and components for hallucinated packages, leaked keys, and insecure AI code.',
    cmd: 'vibeshield scan .',
    badge: 'Full Audit',
  },
  {
    title: '2. Scan Git Diff Against Main',
    desc: 'Audit only the changes made during your current vibe coding session before merging to main.',
    cmd: 'vibeshield scan --diff main',
    badge: 'PR Speed',
  },
  {
    title: '3. Scan Staged Files (Pre-Commit)',
    desc: 'Sub-second check before git commit. Blocks secrets and hallucinated packages before they hit git history.',
    cmd: 'vibeshield scan --staged',
    badge: 'Fast Hook',
  },
  {
    title: '4. Automatically Fix Bugs',
    desc: 'Interactively preview and apply 1-line verified fixes for flagged hallucinated imports and insecure defaults.',
    cmd: 'vibeshield fix .',
    badge: 'Auto-Remediate',
  },
];
---

<section id="how-to-scan" class="section border-t border-[rgba(248,247,226,0.12)] relative bg-[#181b30]">
  <div class="wrap" data-reveal>
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-[rgba(248,247,226,0.18)] bg-[rgba(248,247,226,0.06)] px-3.5 py-1.5 backdrop-blur-md mb-4">
        <span class="h-1.5 w-1.5 rounded-full bg-[#f8f7e2] animate-pulse"></span>
        <span class="font-display text-xs font-bold tracking-wider text-[#f8f7e2] uppercase">
          CLI & Workflow Guide
        </span>
      </div>
      <h2 class="scroll-tell text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-[-0.03em] text-apple-headline font-display">
        How to Scan & Hunt Bugs
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#f8f7e2]/70 leading-relaxed font-sans">
        Run fast, sub-second audits from your terminal or inside your agent. Copy any command below to test your vibe coding code immediately.
      </p>
    </div>

    <!-- Commands Grid -->
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {commands.map((c, i) => (
        <div class="card rounded-2xl border border-[rgba(248,247,226,0.14)] bg-[#242848] p-6 transition-all duration-300 hover:border-[rgba(248,247,226,0.35)] hover:shadow-2xl">
          <div class="flex items-center justify-between border-b border-[rgba(248,247,226,0.12)] pb-3">
            <h3 class="text-base font-bold text-[#f8f7e2] font-display">{c.title}</h3>
            <span class="rounded-md border border-[rgba(248,247,226,0.2)] bg-[rgba(248,247,226,0.06)] px-2 py-0.5 font-mono text-[11px] text-[#f8f7e2]/80">
              {c.badge}
            </span>
          </div>
          <p class="mt-3 text-xs sm:text-sm text-[#f8f7e2]/65 leading-relaxed min-h-[40px] font-sans">
            {c.desc}
          </p>
          <div class="mt-4 relative">
            <pre class="scroll-x rounded-xl border border-[rgba(248,247,226,0.12)] bg-[#131627]/95 p-3.5 font-mono text-xs text-[#f8f7e2]/90 pr-24 overflow-x-auto"><code>{c.cmd}</code></pre>
            <button
              type="button"
              class="scan-copy-btn absolute top-2 right-2 rounded-lg border border-[rgba(248,247,226,0.2)] bg-[rgba(248,247,226,0.08)] px-3 py-1 font-display text-xs font-semibold text-[#f8f7e2] transition-all hover:bg-[#f8f7e2] hover:text-[#474c80] active:scale-95"
              data-cmd={c.cmd}
            >
              <span>Copy</span>
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Terminal Output Demonstration -->
    <div class="mt-10 rounded-2xl border border-[rgba(248,247,226,0.15)] bg-[#131627]/95 p-5 sm:p-6 font-mono text-xs sm:text-sm shadow-2xl">
      <div class="flex items-center justify-between border-b border-[rgba(248,247,226,0.12)] pb-3 mb-4">
        <div class="flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-[rgba(248,247,226,0.35)]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[rgba(248,247,226,0.22)]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[rgba(248,247,226,0.12)]"></span>
          <span class="ml-2 text-[#f8f7e2]/55 text-xs">Terminal Output Preview</span>
        </div>
        <span class="text-[#f8f7e2]/45 text-xs">Completed in 1.2s</span>
      </div>
      <div class="space-y-2 text-[#f8f7e2]/85 leading-relaxed overflow-x-auto">
        <p class="text-[#f8f7e2] font-bold">$ vibeshield scan .</p>
        <p class="text-[#f8f7e2]/55">&nbsp;&nbsp;Scanning 14 vibe-coded files (diff mode)… done in 1.2s</p>
        <div class="mt-2 pl-2 border-l-2 border-[rgba(248,247,226,0.4)] space-y-1">
          <p class="text-[#f8f7e2] font-bold"><span class="bg-[#f8f7e2] text-[#474c80] px-1.5 py-0.5 rounded text-xs font-mono font-bold mr-2">CRITICAL</span>VS-PKG-001 &nbsp;hallucinated-package</p>
          <p class="text-[#f8f7e2]/75">&nbsp;&nbsp;package.json:8 — fast-parse-utils-v3@2.1.4</p>
          <p class="text-[#f8f7e2]/55">&nbsp;&nbsp;Why: LLM hallucinated package name. Registered 9 days ago on npm with remote curl payload.</p>
          <p class="text-[#f8f7e2]/95">&nbsp;&nbsp;→ Fix: Replace with native node:util (clean, 12 lines, zero dependencies).</p>
        </div>
        <div class="mt-2 pl-2 border-l-2 border-[rgba(248,247,226,0.4)] space-y-1">
          <p class="text-[#f8f7e2] font-bold"><span class="bg-[#474c80] text-[#f8f7e2] border border-[rgba(248,247,226,0.3)] px-1.5 py-0.5 rounded text-xs font-mono font-bold mr-2">HIGH</span>VS-SEC-017 &nbsp;hardcoded-secret</p>
          <p class="text-[#f8f7e2]/75">&nbsp;&nbsp;src/agent.ts:41 — OPENAI_API_KEY = "sk-proj-••••••••••••••4a2f"</p>
          <p class="text-[#f8f7e2]/55">&nbsp;&nbsp;Why: Copilot pasted credential echoed from chat context memory.</p>
          <p class="text-[#f8f7e2]/95">&nbsp;&nbsp;→ Fix: Move to process.env.OPENAI_API_KEY and rotate the leaked key immediately.</p>
        </div>
        <p class="pt-2 text-[#f8f7e2] font-semibold">✓ 12 files clean · 2 findings · 0 leaks merged to main</p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.scan-copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const cmd = btn.dataset.cmd;
      if (!cmd) return;
      try {
        await navigator.clipboard.writeText(cmd);
        const original = btn.innerHTML;
        btn.innerHTML = '<span>✓ Copied!</span>';
        btn.classList.add('bg-[#f8f7e2]', 'text-[#474c80]');
        setTimeout(() => {
          btn.innerHTML = original;
          btn.classList.remove('bg-[#f8f7e2]', 'text-[#474c80]');
        }, 2000);
      } catch {
        btn.innerText = 'Press Ctrl+C';
      }
    });
  });
</script>
