---
const commands = [
  {
    title: '1. Scan Entire Project',
    desc: 'Audit all repository files, dependency manifests, and components for hallucinated packages, leaked keys, and insecure code.',
    cmd: 'vibeshield scan .',
    badge: 'Full Audit',
  },
  {
    title: '2. Scan Git Diff Against Main',
    desc: 'Audit only the changed files from your current AI coding session before opening a pull request.',
    cmd: 'vibeshield scan --diff main',
    badge: 'PR Speed',
  },
  {
    title: '3. Scan Staged Files (Pre-Commit)',
    desc: 'Sub-second check before git commit. Blocks secrets and hallucinated imports before they enter git history.',
    cmd: 'vibeshield scan --staged',
    badge: 'Fast Hook',
  },
  {
    title: '4. Automatically Apply 1-Line Fixes',
    desc: 'Interactively preview and auto-remediate flagged hallucinated packages with verified standard library replacements.',
    cmd: 'vibeshield fix .',
    badge: 'Auto-Remediate',
  },
];
---

<section id="how-to-scan" class="section relative" style="background: var(--bg); border-top: 1px solid var(--border);">
  <div class="wrap">
    <div class="max-w-2xl">
      <div
        class="inline-flex items-center gap-2 rounded-full px-3 py-1 mb-3"
        style="border: 1px solid var(--border); background: var(--surface);"
      >
        <span class="h-2 w-2 rounded-full" style="background: var(--ink)"></span>
        <span class="eyebrow" style="color: var(--ink)">
          CLI &amp; Workflow Guide
        </span>
      </div>
      <h2 style="color: var(--ink)">
        How to Scan &amp; Fix Insecure AI Code
      </h2>
      <p class="mt-3 text-base sm:text-lg font-sans" style="color: var(--ink-soft)">
        Run instant local audits from your terminal or inside your agent. Copy any command below to test your workspace immediately.
      </p>
    </div>

    <!-- Commands Grid -->
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {commands.map((c) => (
        <div
          class="card p-6"
          style="background: var(--surface); border: 1px solid var(--border);"
        >
          <div class="flex items-center justify-between pb-3" style="border-bottom: 1px solid var(--border)">
            <h3 class="text-base font-bold font-display" style="color: var(--ink)">{c.title}</h3>
            <span
              class="rounded px-2.5 py-0.5 font-mono text-[11px] font-bold"
              style="border: 1px solid var(--border); background: var(--bg); color: var(--ink);"
            >
              {c.badge}
            </span>
          </div>
          <p class="mt-3 text-xs sm:text-sm leading-relaxed min-h-[40px] font-sans" style="color: var(--ink-soft)">
            {c.desc}
          </p>
          <div class="mt-4 relative">
            <pre
              class="scroll-x rounded-lg p-3.5 font-mono text-xs font-bold pr-24 overflow-x-auto"
              style="border: 1px solid var(--border); background: var(--bg); color: var(--ink);"
            ><code>{c.cmd}</code></pre>
            <button
              type="button"
              class="scan-copy-btn absolute top-2 right-2 rounded px-3 py-1 font-display text-xs font-bold transition-colors"
              style="border: 1px solid var(--border); background: var(--surface); color: var(--ink);"
              data-cmd={c.cmd}
            >
              <span>Copy</span>
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Terminal Output Demonstration -->
    <div
      class="mt-8 rounded-xl p-5 sm:p-6 font-mono text-xs sm:text-sm"
      style="background: var(--surface); border: 1px solid var(--border); color: var(--ink);"
    >
      <div class="flex items-center justify-between pb-3 mb-4" style="border-bottom: 1px solid var(--border)">
        <div class="flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full" style="background: color-mix(in srgb, var(--ink) 30%, transparent)"></span>
          <span class="h-2.5 w-2.5 rounded-full" style="background: color-mix(in srgb, var(--ink) 30%, transparent)"></span>
          <span class="h-2.5 w-2.5 rounded-full" style="background: color-mix(in srgb, var(--ink) 30%, transparent)"></span>
          <span class="ml-2 font-bold text-xs" style="color: var(--ink)">Terminal Output Preview</span>
        </div>
        <span class="text-xs font-semibold" style="color: var(--ink-soft)">Completed in 0.38s</span>
      </div>
      <div class="space-y-2.5 leading-relaxed overflow-x-auto" style="color: var(--ink)">
        <p class="font-bold">$ vibeshield scan .</p>
        <p style="color: var(--ink-soft)">&nbsp;&nbsp;Scanning 14 project files (diff mode)… done in 0.38s</p>
        
        <div
          class="mt-2 pl-3 space-y-1 p-2.5 rounded-r-lg"
          style="border-left: 2px solid var(--danger); background: color-mix(in srgb, var(--danger) 8%, var(--surface));"
        >
          <p class="font-bold" style="color: var(--danger)">
            <span
              class="px-1.5 py-0.5 rounded text-[11px] font-mono font-bold mr-2"
              style="background: var(--danger); color: var(--on-ink);"
            >
              CRITICAL
            </span>
            VS-PKG-001 &nbsp;hallucinated-package
          </p>
          <p style="color: var(--ink)">&nbsp;&nbsp;package.json:8 — fast-parse-utils-v3@2.1.4</p>
          <p style="color: var(--ink-soft)">&nbsp;&nbsp;Why: Package does not exist in registry. Slopsquatting risk.</p>
          <p class="font-semibold" style="color: var(--ok)">&nbsp;&nbsp;→ Fix: Replace with standard library node:util (12 lines, zero dependencies).</p>
        </div>

        <div
          class="mt-2 pl-3 space-y-1 p-2.5 rounded-r-lg"
          style="border-left: 2px solid var(--warn); background: color-mix(in srgb, var(--warn) 8%, var(--surface));"
        >
          <p class="font-bold" style="color: var(--warn)">
            <span
              class="px-1.5 py-0.5 rounded text-[11px] font-mono font-bold mr-2"
              style="background: var(--warn); color: var(--on-ink);"
            >
              HIGH
            </span>
            VS-SEC-017 &nbsp;hardcoded-secret
          </p>
          <p style="color: var(--ink)">&nbsp;&nbsp;src/agent.ts:41 — OPENAI_API_KEY = "sk-proj-••••••••••••••4a2f"</p>
          <p style="color: var(--ink-soft)">&nbsp;&nbsp;Why: Copilot pasted credentials echoed from conversation context memory.</p>
          <p class="font-semibold" style="color: var(--ok)">&nbsp;&nbsp;→ Fix: Read from process.env.OPENAI_API_KEY and rotate the leaked key now.</p>
        </div>

        <p class="pt-2 font-bold" style="color: var(--ok)">✓ 12 files clean · 2 findings · 0 unverified dependencies merged</p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.scan-copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const cmd = btn.dataset.cmd;
      if (!cmd) return;
      try {
        await navigator.clipboard.writeText(cmd);
        const original = btn.innerHTML;
        btn.innerHTML = '<span>✓ Copied!</span>';
        btn.style.background = 'var(--ink)';
        btn.style.color = 'var(--on-ink)';
        setTimeout(() => {
          btn.innerHTML = original;
          btn.style.background = 'var(--surface)';
          btn.style.color = 'var(--ink)';
        }, 2000);
      } catch {
        btn.innerText = 'Press Ctrl+C';
      }
    });
  });
</script>
