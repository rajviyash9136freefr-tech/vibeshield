---
import { FAQ } from '../../data/site';
import { baseHref } from '../../lib/base';

// Exactly 5 FAQs
const items = FAQ.slice(0, 5);

function linkify(text: string): string {
  const esc = text.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  let html = esc.replace(/`([^`]+)`/g, '<code class="font-mono text-xs px-1.5 py-0.5 rounded font-semibold" style="color: var(--ink); background: var(--surface); border: 1px solid var(--border);">$1</code>');
  return html.replace(
    /\*([^*]+)\*/g,
    '<em>$1</em>',
  );
}
---

<section id="faq" class="section relative" style="background: var(--surface); border-top: 1px solid var(--border);">
  <div class="wrap-narrow">
    <div class="max-w-2xl">
      <div
        class="inline-flex items-center gap-2 rounded-full px-3 py-1 mb-3"
        style="border: 1px solid var(--border); background: var(--bg);"
      >
        <span class="eyebrow" style="color: var(--ink)">
          FAQ
        </span>
      </div>
      <h2 style="color: var(--ink)">
        Frequently Asked Questions
      </h2>
      <p class="mt-3 text-base font-sans" style="color: var(--ink-soft)">
        Everything you need to know about AI package hallucinations, offline privacy, and integration with your workflow.
      </p>
    </div>

    <!-- The 5 FAQ Accordions -->
    <div class="mt-8 space-y-3">
      {items.map((item, idx) => (
        <details
          class="faq-item group rounded-xl p-5 sm:p-6 transition-colors duration-150"
          style="background: var(--bg); border: 1px solid var(--border);"
        >
          <summary class="flex cursor-pointer items-start justify-between gap-4 select-none outline-none">
            <div class="flex items-start gap-3.5">
              <span class="font-mono text-xs font-bold mt-0.5" style="color: var(--ink-soft)">0{idx + 1}</span>
              <h3 class="text-base sm:text-lg font-bold leading-snug font-display" style="color: var(--ink)">
                {item.q}
              </h3>
            </div>
            <!-- Expand/Collapse Plus Icon -->
            <span
              class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full transition-transform group-open:rotate-45"
              style="border: 1px solid var(--border); background: var(--surface); color: var(--ink);"
              aria-hidden="true"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 text-sm leading-relaxed pl-7 font-sans" style="border-top: 1px solid var(--border); color: var(--ink-soft);">
            <p set:html={linkify(item.a)} />
            {item.link && (
              <p class="mt-4 pt-3" style="border-top: 1px solid var(--border)">
                <a href={baseHref(item.link[1])} class="inline-flex items-center gap-1.5 font-bold hover:underline text-xs sm:text-sm font-display" style="color: var(--ink)">
                  <span>{item.link[0]}</span>
                  <span>→</span>
                </a>
              </p>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
