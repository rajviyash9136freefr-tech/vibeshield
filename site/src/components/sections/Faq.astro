---
import { FAQ, FAQ_EXTRA } from '../../data/site';
import { baseHref } from '../../lib/base';

// Grouping 16 FAQs into 3 logical categories to reduce page scroll depth and improve scannability
const CATEGORIZED_ITEMS = [
  // 1. Security & Detection
  { ...FAQ[2], category: 'security', categoryLabel: 'Security & Detection' }, // Slopsquatting
  { ...FAQ[1], category: 'security', categoryLabel: 'Security & Detection' }, // Dependabot/Snyk comparison
  { ...FAQ[8], category: 'security', categoryLabel: 'Security & Detection' }, // Auto-fix
  { ...FAQ[9], category: 'security', categoryLabel: 'Security & Detection' }, // Who is responsible
  { ...FAQ_EXTRA[2], category: 'security', categoryLabel: 'Security & Detection' }, // Permissions

  // 2. Agent & CI Integration
  { ...FAQ[0], category: 'integration', categoryLabel: 'Integration & Compatibility' }, // What is VibeShield
  { ...FAQ[3], category: 'integration', categoryLabel: 'Integration & Compatibility' }, // Cursor/Copilot/Claude Code
  { ...FAQ[7], category: 'integration', categoryLabel: 'Integration & Compatibility' }, // 3 minutes setup
  { ...FAQ_EXTRA[1], category: 'integration', categoryLabel: 'Integration & Compatibility' }, // Languages & registries
  { ...FAQ[4], category: 'integration', categoryLabel: 'Integration & Compatibility' }, // Will it slow CI
  { ...FAQ_EXTRA[4], category: 'integration', categoryLabel: 'Integration & Compatibility' }, // GitLab/Azure

  // 3. Privacy, Open Source & Pricing
  { ...FAQ[6], category: 'privacy', categoryLabel: 'Privacy & Pricing' }, // Cost
  { ...FAQ[5], category: 'privacy', categoryLabel: 'Privacy & Pricing' }, // Code leave machine
  { ...FAQ_EXTRA[0], category: 'privacy', categoryLabel: 'Privacy & Pricing' }, // Account or key needed
  { ...FAQ_EXTRA[3], category: 'privacy', categoryLabel: 'Privacy & Pricing' }, // Pin version / air-gapped
  { ...FAQ_EXTRA[5], category: 'privacy', categoryLabel: 'Privacy & Pricing' }, // Terms & data
];

function linkify(text: string): string {
  const esc = text.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  let html = esc.replace(/`([^`]+)`/g, '<code class="font-mono text-xs text-white bg-white/10 px-1.5 py-0.5 rounded-md">$1</code>');
  return html.replace(
    /\*([^*]+)\*/g,
    '<em>$1</em>',
  );
}
---

<section id="faq" class="section border-t border-white/10 relative">
  <div class="wrap" data-reveal>
    <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 backdrop-blur-md mb-4">
      <span class="font-mono text-xs font-medium tracking-normal text-white/80">
        Knowledge Base
      </span>
    </div>
    <h2 class="scroll-tell text-3xl font-bold tracking-[-0.035em] text-apple-headline sm:text-4xl lg:text-5xl">
      Frequently asked questions
    </h2>
    <p class="mt-3 text-base text-white/65">
      Find quick answers about security architecture, agent integration, privacy guarantees, and open-source licensing.
    </p>

    <!-- Search Bar and Category Tabs -->
    <div class="mt-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2" id="faq-categories" role="tablist">
        <button
          type="button"
          data-category="all"
          class="faq-cat-btn rounded-full border border-white bg-white text-black px-4 py-1.5 text-xs font-semibold shadow-sm transition-all"
        >
          All (16)
        </button>
        <button
          type="button"
          data-category="security"
          class="faq-cat-btn rounded-full border border-white/20 bg-white/5 text-white/70 px-4 py-1.5 text-xs font-medium hover:text-white hover:border-white/40 transition-all"
        >
          Security & Detection (5)
        </button>
        <button
          type="button"
          data-category="integration"
          class="faq-cat-btn rounded-full border border-white/20 bg-white/5 text-white/70 px-4 py-1.5 text-xs font-medium hover:text-white hover:border-white/40 transition-all"
        >
          Integration (6)
        </button>
        <button
          type="button"
          data-category="privacy"
          class="faq-cat-btn rounded-full border border-white/20 bg-white/5 text-white/70 px-4 py-1.5 text-xs font-medium hover:text-white hover:border-white/40 transition-all"
        >
          Privacy & Pricing (5)
        </button>
      </div>

      <label class="block w-full sm:max-w-xs">
        <span class="sr-only">Search questions</span>
        <div class="relative">
          <input
            id="faq-search"
            type="search"
            placeholder="Search questions…"
            autocomplete="off"
            class="w-full rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs text-white placeholder:text-white/40 focus:border-white focus:bg-black/80 transition-all outline-none"
          />
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-white/40 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
        </div>
      </label>
    </div>

    <!-- Categorized FAQ Accordion List -->
    <div class="mt-8 max-w-3xl space-y-3.5">
      {CATEGORIZED_ITEMS.map((item, i) => (
        <details
          class="faq-item card group rounded-2xl border border-white/10 bg-[#09090c] p-5 sm:p-6 transition-all duration-200 hover:border-white/25"
          open={i === 0}
          data-category={item.category}
          data-terms={`${item.q} ${item.a}`.toLowerCase()}
        >
          <summary class="flex items-start justify-between gap-4">
            <div>
              <span class="text-xs font-mono text-white/40 mb-1 block uppercase tracking-wider">{item.categoryLabel}</span>
              <h3 class="text-base sm:text-lg font-semibold text-white leading-snug">{item.q}</h3>
            </div>
            <!-- Prominent Expand/Collapse Icon with Bold Visual Affordance -->
            <span
              class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-white/25 bg-white/10 text-white transition-all duration-300 group-open:rotate-45 group-open:bg-white group-open:text-black"
              aria-hidden="true"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </summary>
          <div class="faq-a mt-4 border-t border-white/10 pt-4 text-sm leading-relaxed text-white/70">
            <p set:html={linkify(item.a)} />
            {item.link && (
              <p class="mt-4 pt-3 border-t border-white/5">
                <a href={baseHref(item.link[1])} class="inline-flex items-center gap-1.5 text-white font-medium hover:underline text-xs sm:text-sm">
                  <span>{item.link[0]}</span>
                  <span>→</span>
                </a>
              </p>
            )}
          </div>
        </details>
      ))}
    </div>
    <p id="faq-empty" class="mt-8 hidden text-sm font-mono text-white/50">No question matches your search term.</p>
  </div>
</section>

<script>
  const input = document.getElementById('faq-search') as HTMLInputElement | null;
  const items = [...document.querySelectorAll<HTMLDetailsElement>('.faq-item')];
  const catButtons = [...document.querySelectorAll<HTMLButtonElement>('.faq-cat-btn')];
  const empty = document.getElementById('faq-empty');

  let activeCategory = 'all';

  function filterFaqs() {
    const q = input?.value.trim().toLowerCase() ?? '';
    let shown = 0;

    for (const el of items) {
      const matchCat = activeCategory === 'all' || el.dataset.category === activeCategory;
      const matchQuery = !q || (el.dataset.terms ?? '').includes(q);
      const isVisible = matchCat && matchQuery;

      el.style.display = isVisible ? '' : 'none';
      if (isVisible) {
        shown++;
        if (q) el.open = true;
      }
    }
    empty?.classList.toggle('hidden', shown > 0);
  }

  input?.addEventListener('input', filterFaqs);

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.category ?? 'all';
      catButtons.forEach((b) => {
        if (b === btn) {
          b.className = 'faq-cat-btn rounded-full border border-white bg-white text-black px-4 py-1.5 text-xs font-semibold shadow-sm transition-all';
        } else {
          b.className = 'faq-cat-btn rounded-full border border-white/20 bg-white/5 text-white/70 px-4 py-1.5 text-xs font-medium hover:text-white hover:border-white/40 transition-all';
        }
      });
      filterFaqs();
    });
  });
</script>
