---
import { FAQ } from '../../data/site';
import { baseHref } from '../../lib/base';

// Exactly 5 FAQs
const items = FAQ.slice(0, 5);

function linkify(text: string): string {
  const esc = text.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  let html = esc.replace(/`([^`]+)`/g, '<code class="font-mono text-xs text-[#474c80] bg-[#faf9f0] border border-[rgba(71,76,128,0.18)] px-1.5 py-0.5 rounded-md font-semibold">$1</code>');
  return html.replace(
    /\*([^*]+)\*/g,
    '<em>$1</em>',
  );
}
---

<section id="faq" class="section border-t border-[rgba(71,76,128,0.15)] relative bg-[#faf9f0]">
  <div class="wrap-narrow">
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-[rgba(71,76,128,0.22)] bg-white px-3.5 py-1.5 shadow-sm mb-4">
        <span class="font-display text-xs font-bold tracking-wider text-[#474c80] uppercase">
          FAQ
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-[-0.03em] text-[#474c80] font-display">
        Frequently Asked Questions
      </h2>
      <p class="mt-3 text-base text-[#474c80]/80 font-sans">
        Everything you need to know about AI package hallucinations, offline privacy, and integration with your workflow.
      </p>
    </div>

    <!-- The 5 FAQ Accordions -->
    <div class="mt-10 space-y-3.5">
      {items.map((item, idx) => (
        <details
          class="faq-item card group rounded-2xl border border-[rgba(71,76,128,0.2)] bg-white p-5 sm:p-6 transition-colors duration-150 hover:border-[#474c80] open:border-[#474c80] shadow-sm"
        >
          <summary class="flex cursor-pointer items-start justify-between gap-4 select-none outline-none">
            <div class="flex items-start gap-3.5">
              <span class="font-mono text-xs font-bold text-[#474c80]/50 mt-0.5">0{idx + 1}</span>
              <h3 class="text-base sm:text-lg font-bold text-[#474c80] leading-snug font-display">
                {item.q}
              </h3>
            </div>
            <!-- Expand/Collapse Plus Icon -->
            <span
              class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[rgba(71,76,128,0.25)] bg-[#faf9f0] text-[#474c80] transition-colors group-open:rotate-45 group-open:bg-[#474c80] group-open:text-[#f8f7e2]"
              aria-hidden="true"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </summary>
          <div class="mt-4 border-t border-[rgba(71,76,128,0.15)] pt-4 text-sm leading-relaxed text-[#474c80]/85 pl-7 font-sans">
            <p set:html={linkify(item.a)} />
            {item.link && (
              <p class="mt-4 pt-3 border-t border-[rgba(71,76,128,0.12)]">
                <a href={baseHref(item.link[1])} class="inline-flex items-center gap-1.5 text-[#474c80] font-bold hover:underline text-xs sm:text-sm font-display">
                  <span>{item.link[0]}</span>
                  <span>→</span>
                </a>
              </p>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
