---
import { FAQ, FAQ_EXTRA } from '../../data/site';
import { baseHref } from '../../lib/base';

const ITEMS = [...FAQ, ...FAQ_EXTRA];

function linkify(text: string): string {
  const esc = text.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  let html = esc.replace(/`([^`]+)`/g, '<code class="font-mono text-[0.92em] text-white bg-white/10 px-1.5 py-0.5 rounded">$1</code>');
  return html.replace(
    /\*([^*]+)\*/g,
    '<em>$1</em>',
  );
}
---

<section id="faq" class="section border-t border-white/10 relative">
  <div class="wrap" data-reveal>
    <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1 backdrop-blur-md mb-4">
      <span class="font-mono text-[11px] font-medium tracking-wider text-white/70 uppercase">
        Knowledge Base
      </span>
    </div>
    <h2 class="scroll-tell text-[32px] font-bold tracking-[-0.035em] text-apple-headline sm:text-[42px] lg:text-[48px]">
      Frequently asked questions
    </h2>

    <label class="mt-8 block max-w-md">
      <span class="sr-only">Search questions</span>
      <div class="relative">
        <input
          id="faq-search"
          type="search"
          placeholder="Search questions (e.g. slopsquatting, keys, pricing)…"
          autocomplete="off"
          class="w-full rounded-full border border-white/15 bg-white/5 px-5 py-3 text-sm text-white placeholder:text-white/40 focus:border-white focus:bg-black/80 transition-all outline-none"
        />
        <svg class="absolute right-4 top-1/2 -translate-y-1/2 h-4 w-4 text-white/40 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.3-4.3"/>
        </svg>
      </div>
    </label>

    <div class="mt-10 grid items-start gap-4 lg:grid-cols-2">
      {ITEMS.map((item, i) => (
        <details class="faq-item card group rounded-2xl border border-white/10 bg-[#09090c] p-5 sm:p-6 transition-all duration-200 hover:border-white/25" open={i < 2} data-terms={`${item.q} ${item.a}`.toLowerCase()}>
          <summary class="flex items-start justify-between gap-4">
            <h3 class="text-[16.5px] font-semibold text-white leading-snug">{item.q}</h3>
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-white/20 bg-white/5 font-mono text-xs text-white/70 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="faq-a mt-4 border-t border-white/10 pt-3 text-[14.5px] leading-relaxed text-white/65">
            <p set:html={linkify(item.a)} />
            {item.link && (
              <p class="mt-3">
                <a href={baseHref(item.link[1])} class="inline-flex items-center gap-1 text-white font-medium hover:underline text-sm">
                  <span>{item.link[0] === item.link[1] ? item.link[1] : item.link[0]}</span>
                  <span>→</span>
                </a>
              </p>
            )}
          </div>
        </details>
      ))}
    </div>
    <p id="faq-empty" class="mt-8 hidden text-sm font-mono text-white/50">No question matches your search term.</p>
  </div>
</section>

<script>
  const input = document.getElementById('faq-search') as HTMLInputElement | null;
  const items = [...document.querySelectorAll<HTMLDetailsElement>('.faq-item')];
  const empty = document.getElementById('faq-empty');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const el of items) {
      const hit = !q || (el.dataset.terms ?? '').includes(q);
      el.style.display = hit ? '' : 'none';
      if (hit) {
        shown++;
        if (q) el.open = true;
      }
    }
    empty?.classList.toggle('hidden', shown > 0);
  });
</script>
