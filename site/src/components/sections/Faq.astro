---
import { FAQ } from '../../data/site';
import { baseHref } from '../../lib/base';

// Exactly 5 FAQs as requested
const items = FAQ.slice(0, 5);

function linkify(text: string): string {
  const esc = text.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  let html = esc.replace(/`([^`]+)`/g, '<code class="font-mono text-xs text-white bg-white/10 px-1.5 py-0.5 rounded-md">$1</code>');
  return html.replace(
    /\*([^*]+)\*/g,
    '<em>$1</em>',
  );
}
---

<section id="faq" class="section border-t border-white/10 relative bg-black/60">
  <div class="wrap-narrow" data-reveal>
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 backdrop-blur-md mb-4">
        <span class="font-mono text-xs font-medium tracking-normal text-white/80">
          FAQ
        </span>
      </div>
      <h2 class="scroll-tell text-3xl font-bold tracking-[-0.035em] text-apple-headline sm:text-4xl lg:text-5xl">
        Frequently asked questions
      </h2>
      <p class="mt-3 text-base text-white/65">
        Everything you need to know about testing vibe coding apps, agent installation, and offline safety.
      </p>
    </div>

    <!-- The 5 Curated FAQ Accordions -->
    <div class="mt-10 space-y-4">
      {items.map((item, idx) => (
        <details
          class="faq-item card group rounded-2xl border border-white/10 bg-[#09090c] p-5 sm:p-6 transition-all duration-300 hover:border-white/30 hover:shadow-[0_12px_32px_-8px_rgba(0,0,0,0.8),0_0_20px_rgba(255,255,255,0.03)] open:border-white/35 open:bg-gradient-to-b open:from-[#111116] open:to-[#08080a] open:shadow-[0_20px_50px_-12px_rgba(0,0,0,0.9),0_0_30px_rgba(255,255,255,0.04)]"
          data-tilt="2"
        >
          <summary class="flex cursor-pointer items-start justify-between gap-4 select-none outline-none">
            <div class="flex items-start gap-3.5">
              <span class="font-mono text-xs font-bold text-white/40 mt-0.5">0{idx + 1}</span>
              <h3 class="text-base sm:text-lg font-semibold text-white leading-snug transition-colors group-hover:text-white group-open:text-white">
                {item.q}
              </h3>
            </div>
            <!-- 3D Expand/Collapse Plus Icon -->
            <span
              class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-white/20 bg-white/5 text-white transition-all duration-300 group-hover:scale-110 group-hover:border-white group-open:rotate-45 group-open:bg-white group-open:text-black shadow-sm"
              aria-hidden="true"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </summary>
          <div class="faq-a mt-4 border-t border-white/10 pt-4 text-sm leading-relaxed text-white/75 pl-7">
            <p set:html={linkify(item.a)} />
            {item.link && (
              <p class="mt-4 pt-3 border-t border-white/5">
                <a href={baseHref(item.link[1])} class="inline-flex items-center gap-1.5 text-white font-medium hover:underline text-xs sm:text-sm">
                  <span>{item.link[0]}</span>
                  <span>→</span>
                </a>
              </p>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item {
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }
  .faq-item[open] .faq-a {
    animation: faq-card-3d 200ms ease-out both;
  }
  @keyframes faq-card-3d {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
