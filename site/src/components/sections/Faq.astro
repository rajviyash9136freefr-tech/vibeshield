---
import { FAQ } from '../../data/site';
import { baseHref } from '../../lib/base';

// Exactly 5 FAQs as requested
const items = FAQ.slice(0, 5);

function linkify(text: string): string {
  const esc = text.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  let html = esc.replace(/`([^`]+)`/g, '<code class="font-mono text-xs text-white bg-white/10 px-1.5 py-0.5 rounded-md">$1</code>');
  return html.replace(
    /\*([^*]+)\*/g,
    '<em>$1</em>',
  );
}
---

<section id="faq" class="section border-t border-[rgba(248,247,226,0.12)] relative bg-[#181b30]">
  <div class="wrap-narrow" data-reveal>
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-[rgba(248,247,226,0.18)] bg-[rgba(248,247,226,0.06)] px-3.5 py-1.5 backdrop-blur-md mb-4">
        <span class="font-display text-xs font-bold tracking-wider text-[#f8f7e2] uppercase">
          FAQ
        </span>
      </div>
      <h2 class="scroll-tell text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-[-0.03em] text-apple-headline font-display">
        Frequently asked questions
      </h2>
      <p class="mt-3 text-base text-[#f8f7e2]/70 font-sans">
        Everything you need to know about testing vibe coding apps, agent installation, and offline safety.
      </p>
    </div>

    <!-- The 5 Curated FAQ Accordions -->
    <div class="mt-10 space-y-4">
      {items.map((item, idx) => (
        <details
          class="faq-item card group rounded-2xl border border-[rgba(248,247,226,0.14)] bg-[#242848] p-5 sm:p-6 transition-all duration-300 hover:border-[rgba(248,247,226,0.35)] hover:shadow-[0_12px_32px_-8px_rgba(19,22,39,0.8),0_0_20px_rgba(71,76,128,0.2)] open:border-[rgba(248,247,226,0.35)] open:bg-gradient-to-b open:from-[#2e335e] open:to-[#222544] open:shadow-[0_20px_50px_-12px_rgba(19,22,39,0.95),0_0_30px_rgba(71,76,128,0.3)]"
          data-tilt="2"
        >
          <summary class="flex cursor-pointer items-start justify-between gap-4 select-none outline-none">
            <div class="flex items-start gap-3.5">
              <span class="font-mono text-xs font-bold text-[#f8f7e2]/50 mt-0.5">0{idx + 1}</span>
              <h3 class="text-base sm:text-lg font-bold text-[#f8f7e2] leading-snug transition-colors group-hover:text-[#f8f7e2] group-open:text-[#f8f7e2] font-display">
                {item.q}
              </h3>
            </div>
            <!-- 3D Expand/Collapse Plus Icon -->
            <span
              class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[rgba(248,247,226,0.2)] bg-[rgba(248,247,226,0.06)] text-[#f8f7e2] transition-all duration-300 group-hover:scale-110 group-hover:border-[#f8f7e2] group-open:rotate-45 group-open:bg-[#f8f7e2] group-open:text-[#474c80] shadow-sm"
              aria-hidden="true"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </summary>
          <div class="faq-a mt-4 border-t border-[rgba(248,247,226,0.12)] pt-4 text-sm leading-relaxed text-[#f8f7e2]/80 pl-7 font-sans">
            <p set:html={linkify(item.a)} />
            {item.link && (
              <p class="mt-4 pt-3 border-t border-[rgba(248,247,226,0.08)]">
                <a href={baseHref(item.link[1])} class="inline-flex items-center gap-1.5 text-[#f8f7e2] font-bold hover:underline text-xs sm:text-sm font-display">
                  <span>{item.link[0]}</span>
                  <span>→</span>
                </a>
              </p>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item {
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }
  .faq-item[open] .faq-a {
    animation: faq-card-3d 200ms ease-out both;
  }
  @keyframes faq-card-3d {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
