---
/**
 * 4 Core Capabilities of VibeShield
 * Clean inline SVGs (Phosphor / Lucide style) — no emojis.
 * Built with strict CSS tokens and responsive grid.
 */
const pillars = [
  {
    tag: 'SLOPSQUATTING DEFENSE',
    title: 'Hallucinated Package Blocker',
    desc: 'LLMs routinely invent plausible package names. Attackers register these hallucinated names on npm and PyPI within hours. VibeShield checks package age, maintainer count, and registry existence before installation.',
    svg: `<path d="m7.5 4.27 9 5.15M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/>`,
  },
  {
    tag: 'ENTROPY SCANNER',
    title: 'Zero-Leak Secret Quarantine',
    desc: 'Catches OpenAI, Anthropic, AWS, GitHub, and database credentials echoed by coding agents into source files or test fixtures. Generates immediate rotation warnings before git commit.',
    svg: `<circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6M15.5 7.5l3 3M18.5 4.5l2 2"/>`,
  },
  {
    tag: 'SCAFFOLD SANITIZER',
    title: 'Insecure Boilerplate Blocker',
    desc: 'Refuses unsafe AI scaffolding defaults: wildcard CORS (*), unhashed passwords, disabled TLS verification, JWT alg "none", and eval() executed directly on model outputs.',
    svg: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>`,
  },
  {
    tag: 'AIR-GAPPED PERFORMANCE',
    title: 'Sub-Second Local Execution',
    desc: 'Written in high-performance native code. Runs in under 400ms across your local git diff. 100% offline, zero cloud calls, zero telemetry — your intellectual property never leaves your laptop.',
    svg: `<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>`,
  },
];
---

<section id="features" class="section" style="background: var(--bg); border-top: 1px solid var(--border);">
  <div class="wrap">
    <div class="max-w-2xl">
      <div
        class="inline-flex items-center gap-2 rounded-full px-3 py-1 mb-3"
        style="border: 1px solid var(--border); background: var(--surface);"
      >
        <span class="h-2 w-2 rounded-full" style="background: var(--ink)"></span>
        <span class="eyebrow" style="color: var(--ink)">
          Core Capabilities
        </span>
      </div>
      <h2 style="color: var(--ink)">
        Built Specifically for AI-Generated Code
      </h2>
      <p class="mt-3 text-base sm:text-lg font-sans" style="color: var(--ink-soft)">
        Traditional security scanners search for known historical CVEs. VibeShield inspects the new failure modes introduced when LLMs write code.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {pillars.map((p) => (
        <div
          class="card p-6 flex flex-col justify-between"
          style="background: var(--surface); border: 1px solid var(--border);"
        >
          <div>
            <div class="flex items-center justify-between">
              <div
                class="flex h-10 w-10 items-center justify-center rounded-lg"
                style="background: var(--bg); border: 1px solid var(--border); color: var(--ink)"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.svg} />
              </div>
              <span
                class="rounded px-2 py-0.5 font-mono text-[10px] font-bold"
                style="border: 1px solid var(--border); background: var(--bg); color: var(--ink)"
              >
                {p.tag}
              </span>
            </div>
            <h3 class="mt-5 text-lg font-bold font-display" style="color: var(--ink)">
              {p.title}
            </h3>
            <p class="mt-2.5 text-xs sm:text-sm leading-relaxed font-sans" style="color: var(--ink-soft)">
              {p.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
