---
import { STEPS } from '../../data/site';
import CodeBlock from '../ui/CodeBlock.astro';
---

<section id="how" class="section border-t border-white/10 relative">
  <div class="wrap">
    <div data-reveal>
      <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 backdrop-blur-md mb-4">
        <span class="font-mono text-xs font-medium tracking-normal text-white/80">
          Integration Flow
        </span>
      </div>
      <h2 class="scroll-tell text-3xl font-bold tracking-[-0.035em] text-apple-headline sm:text-4xl lg:text-5xl">
        Three minutes, end to end
      </h2>
      <p class="mt-3 text-base text-white/65">
        Seamless GitHub Action or pre-commit hook integration. Zero accounts, zero sidecars, fully local.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3 items-stretch">
      {STEPS.map((s, i) => (
        <div data-reveal style={`--reveal-delay: ${i * 80}ms`} class="h-full">
          <div
            class="card relative h-full flex flex-col justify-between overflow-hidden p-6 sm:p-7 border border-white/15 bg-gradient-to-b from-[#0e0e12] to-[#040406] shadow-xl transition-all duration-300 hover:border-white/35"
            data-tilt="5"
          >
            <div>
              <div class="flex items-center justify-between" data-depth style="--z: 24px">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-white/25 bg-white/10 font-mono text-xs font-bold text-white shadow-[0_0_12px_rgba(255,255,255,0.2)]">
                  0{i + 1}
                </span>
                <span class="font-mono text-xs text-white/50 uppercase tracking-widest">STEP</span>
              </div>
              <h3 class="mt-4 text-lg font-semibold text-white leading-tight" data-depth style="--z: 16px">
                {s.h3}
              </h3>
              <p class="mt-2 text-sm text-white/70 leading-relaxed min-h-[44px]">
                {s.body}
              </p>
            </div>
            <div class="mt-6" data-depth style="--z: 20px">
              <CodeBlock code={s.code} filename={`step-0${i + 1}`} label={s.h3} />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
