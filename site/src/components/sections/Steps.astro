---
import { STEPS } from '../../data/site';
import CodeBlock from '../ui/CodeBlock.astro';
---

<section id="how" class="section border-t border-white/10 relative">
  <div class="wrap">
    <div data-reveal>
      <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1 backdrop-blur-md mb-4">
        <span class="font-mono text-[11px] font-medium tracking-wider text-white/70 uppercase">
          Integration Flow
        </span>
      </div>
      <h2 class="scroll-tell text-[32px] font-bold tracking-[-0.035em] text-apple-headline sm:text-[42px] lg:text-[48px]">
        Three minutes, end to end
      </h2>
      <p class="mt-3 text-base text-white/60">
        Seamless GitHub Action or pre-commit hook integration. Zero accounts, zero sidecars, fully local.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {STEPS.map((s, i) => (
        <div data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <div class="card relative h-full flex flex-col overflow-hidden p-6 sm:p-7" data-tilt="4">
            <div class="flex-1">
              <div class="flex items-center justify-between">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-white/20 bg-white/10 font-mono text-xs font-bold text-white">
                  0{i + 1}
                </span>
                <span class="font-mono text-xs text-white/40 uppercase tracking-widest">STEP</span>
              </div>
              <h3 class="mt-4 text-lg font-semibold text-white leading-tight">{s.h3}</h3>
              <p class="mt-2 text-sm text-white/65 leading-relaxed">{s.body}</p>
            </div>
            <CodeBlock code={s.code} class="mt-5" label={`Copy snippet: ${s.h3}`} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
