---
import { PROBLEM } from '../../data/site';
---

<section id="product" class="section border-t border-white/10 relative">
  <div class="wrap">
    <div data-reveal>
      <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 backdrop-blur-md mb-4">
        <span class="font-mono text-xs font-medium tracking-normal text-white/80">
          Threat Model
        </span>
      </div>
      <h2 class="scroll-tell max-w-[24ch] text-3xl font-bold leading-[1.15] tracking-[-0.035em] text-apple-headline sm:text-4xl lg:text-5xl">
        {PROBLEM.h2}
      </h2>
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="space-y-6 text-base leading-[1.75] text-white/70 relative" data-reveal>
        <!-- Cinematic scroll tell: laser hairline draws itself as section scrolls -->
        <div class="draw-line absolute -left-6 top-1 hidden h-[calc(100%-8px)] w-px bg-white/20 lg:block" aria-hidden="true"></div>
        {PROBLEM.paras.map((p) => <p>{p}</p>)}
      </div>

      <div class="scroll-in" data-reveal style="--reveal-delay: 100ms">
        <div class="scroll-x fade-x rounded-2xl border border-white/15 bg-gradient-to-b from-[#0e0e12] to-[#040406] shadow-2xl">
          <table class="w-full min-w-[560px] border-collapse text-sm">
            <caption class="px-5 pt-4 text-left font-mono text-xs text-white/40">
              {PROBLEM.table.caption}
            </caption>
            <thead>
              <tr class="border-b border-white/10 text-left font-mono text-xs text-white/50">
                {PROBLEM.table.cols.map((c) => (
                  <th scope="col" class="px-5 py-3.5 font-semibold text-white/90">{c}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {PROBLEM.table.rows.map(([mode, looks, catch_]) => (
                <tr class="border-b border-white/5 last:border-0 align-top transition-colors hover:bg-white/[0.02]">
                  <th scope="row" class="px-5 py-3.5 font-medium text-white text-left">{mode}</th>
                  <td class="px-5 py-3.5 text-white/65 font-mono text-xs">{looks}</td>
                  <td class="px-5 py-3.5 text-white/40 text-xs">{catch_}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
