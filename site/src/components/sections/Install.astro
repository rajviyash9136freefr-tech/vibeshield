---
// §3.7 — pill tabs, copy buttons, "Takes ~3 minutes · no account needed".
import { INSTALL_TABS } from '../../data/site';

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
---

<section id="install" class="section border-t border-[var(--color-hairline)]">
  <div class="wrap-narrow">
    <h2 class="scroll-tell text-[28px] font-bold tracking-[-0.02em] lg:text-[40px]">Install VibeShield in 3 minutes</h2>
    <p class="mt-3 text-[17px] text-[var(--color-muted)]">
      Add <code class="font-mono text-[15px] text-[var(--color-fg)]">uses: vibeshield/action@v1</code> to your
      workflow, or run <code class="font-mono text-[15px] text-[var(--color-fg)]">npx vibeshield init</code> for the
      hook + workflow + config in one command. Free and MIT-licensed — no account, no signup, for any repo.
    </p>

    <div class="mt-8" data-tabs>
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Install method">
        {INSTALL_TABS.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${t.id}`}
            tabindex={i === 0 ? '0' : '-1'}
            class={`rounded-full border px-4 py-1.5 text-sm transition-colors duration-150 ${i === 0 ? 'border-[var(--color-accent)] bg-[var(--color-accent-dim)] text-[var(--color-accent)]' : 'border-[var(--color-hairline)] text-[var(--color-muted)] hover:text-[var(--color-fg)]'}`}
          >{t.label}</button>
        ))}
      </div>
      {INSTALL_TABS.map((t, i) => (
        <div
          role="tabpanel"
          id={`panel-${t.id}`}
          aria-labelledby={`tab-${t.id}`}
          hidden={i !== 0}
          class="relative mt-4"
        >
          <pre
            class="scroll-x fade-x rounded-[var(--radius-card)] border border-[var(--color-hairline)] bg-[var(--color-elevated)] p-5 font-mono text-[13.5px] leading-[1.7] text-[var(--color-fg)]"
            tabindex="0"
            data-code
          ><code set:html={esc(t.code)} /></pre>
          <button
            type="button"
            class="absolute top-4 right-4 rounded-[var(--radius-btn)] border border-[var(--color-hairline)] bg-[var(--color-bg)] px-3 py-1.5 text-xs text-[var(--color-muted)] transition-colors duration-150 hover:text-[var(--color-accent)]"
            data-copy
            aria-label={`Copy ${t.label} snippet`}
          >Copy</button>
        </div>
      ))}
    </div>
    <p class="mt-3 text-sm text-[var(--color-faint)]">Takes ~3 minutes · no account needed</p>
  </div>
</section>

<script>
  // Tabs (~15 lines, UIUX §8: the only JS here besides copy buttons).
  const root = document.querySelector('[data-tabs]');
  if (root) {
    const tabs = [...root.querySelectorAll('[role=tab]')];
    const panels = [...root.querySelectorAll('[role=tabpanel]')];
    const select = (i: number) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
        t.className =
          'rounded-full border px-4 py-1.5 text-sm transition-colors duration-150 ' +
          (i === j
            ? 'border-[var(--color-accent)] bg-[var(--color-accent-dim)] text-[var(--color-accent)]'
            : 'border-[var(--color-hairline)] text-[var(--color-muted)] hover:text-[var(--color-fg)]');
      });
      panels.forEach((p, j) => (p.hidden = i !== j));
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));
    root.querySelector('[role=tablist]')?.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      const cur = tabs.findIndex((t) => t === document.activeElement);
      if (k === 'ArrowRight') select((cur + 1) % tabs.length);
      if (k === 'ArrowLeft') select((cur - 1 + tabs.length) % tabs.length);
    });
  }
</script>
