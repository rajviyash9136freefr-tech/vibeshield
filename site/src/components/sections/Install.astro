---
import { INSTALL_TABS } from '../../data/site';

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
---

<section id="install" class="section relative" style="background: var(--surface); border-top: 1px solid var(--border);">
  <div class="wrap-narrow">
    <div
      class="inline-flex items-center gap-2 rounded-full px-3 py-1 mb-3"
      style="border: 1px solid var(--border); background: var(--bg);"
    >
      <span class="eyebrow" style="color: var(--ink)">
        Deployment
      </span>
    </div>
    <h2 style="color: var(--ink)">
      Install VibeShield in Under 60 Seconds
    </h2>
    <p class="mt-3 text-base sm:text-lg font-sans" style="color: var(--ink-soft)">
      Install the offline binary for Windows, macOS, or Linux, add it as a git pre-commit hook, or enforce it in CI via our official GitHub Action.
    </p>

    <div class="mt-8" data-tabs>
      <!-- Segmented Control Container -->
      <div
        class="inline-flex flex-wrap rounded-full p-1"
        style="border: 1px solid var(--border); background: var(--bg);"
        role="tablist"
        aria-label="Install method"
      >
        {INSTALL_TABS.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${t.id}`}
            tabindex={i === 0 ? '0' : '-1'}
            class="rounded-full px-4 sm:px-5 py-2 text-xs font-bold font-display transition-colors"
            style={i === 0 ? 'background: var(--ink); color: var(--on-ink);' : 'color: var(--ink-soft);'}
          >
            {t.label}
          </button>
        ))}
      </div>

      {INSTALL_TABS.map((t, i) => (
        <div
          role="tabpanel"
          id={`panel-${t.id}`}
          aria-labelledby={`tab-${t.id}`}
          hidden={i !== 0}
          class="relative mt-6"
        >
          <pre
            class="scroll-x rounded-xl p-6 font-mono text-xs sm:text-sm leading-[1.75] font-semibold overflow-x-auto"
            style="border: 1px solid var(--border); background: var(--bg); color: var(--ink);"
            tabindex="0"
            data-code
          ><code set:html={esc(t.code)} /></pre>
          <button
            type="button"
            class="absolute top-4 right-4 rounded-lg px-3.5 py-1.5 font-display text-xs font-bold transition-colors"
            style="border: 1px solid var(--border); background: var(--surface); color: var(--ink);"
            data-copy
            aria-label={`Copy ${t.label} snippet`}
          >
            Copy
          </button>
        </div>
      ))}
    </div>

    <div class="mt-4 flex items-center gap-2 text-xs" style="color: var(--ink-soft)">
      <span class="h-1.5 w-1.5 rounded-full" style="background: var(--ok)"></span>
      <span class="font-sans font-semibold">Zero accounts, zero external API keys, 100% free and open-source</span>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-tabs]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const select = (i: number) => {
      tabs.forEach((t, j) => {
        const isSelected = i === j;
        t.setAttribute('aria-selected', String(isSelected));
        t.tabIndex = isSelected ? 0 : -1;
        if (isSelected) {
          t.style.background = 'var(--ink)';
          t.style.color = 'var(--on-ink)';
        } else {
          t.style.background = 'transparent';
          t.style.color = 'var(--ink-soft)';
        }
      });
      panels.forEach((p, j) => (p.hidden = i !== j));
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));
    root.querySelector('[role=tablist]')?.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      const cur = tabs.findIndex((t) => t === document.activeElement);
      if (k === 'ArrowRight') select((cur + 1) % tabs.length);
      if (k === 'ArrowLeft') select((cur - 1 + tabs.length) % tabs.length);
    });
  }
</script>
