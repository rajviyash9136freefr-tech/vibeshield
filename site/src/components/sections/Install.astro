---
import { INSTALL_TABS } from '../../data/site';

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
---

<section id="install" class="section border-t border-white/10 relative">
  <div class="wrap-narrow" data-reveal>
    <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 backdrop-blur-md mb-4">
      <span class="font-mono text-xs font-medium tracking-normal text-white/80">
        Deployment
      </span>
    </div>
    <h2 class="scroll-tell text-3xl font-bold tracking-[-0.035em] text-apple-headline sm:text-4xl lg:text-5xl">
      How to Install VibeShield
    </h2>
    <p class="mt-4 text-base leading-relaxed text-white/65 sm:text-lg">
      Install VibeShield as an AI agent skill, run the automated one-line terminal installer for macOS/Windows/Linux, test instantly via npx, or enforce it in CI with our GitHub Action.
    </p>

    <div class="mt-10" data-tabs>
      <!-- Apple-style Segmented Control Container -->
      <div class="inline-flex flex-wrap rounded-full border border-white/15 bg-white/5 p-1 backdrop-blur-xl" role="tablist" aria-label="Install method">
        {INSTALL_TABS.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${t.id}`}
            tabindex={i === 0 ? '0' : '-1'}
            class={`rounded-full px-5 py-2 text-xs font-semibold tracking-tight transition-all duration-200 ${i === 0 ? 'bg-white text-black shadow-[0_2px_12px_rgba(255,255,255,0.2)]' : 'text-white/60 hover:text-white'}`}
          >{t.label}</button>
        ))}
      </div>

      {INSTALL_TABS.map((t, i) => (
        <div
          role="tabpanel"
          id={`panel-${t.id}`}
          aria-labelledby={`tab-${t.id}`}
          hidden={i !== 0}
          class="relative mt-6"
        >
          <pre
            class="scroll-x fade-x rounded-2xl border border-white/15 bg-black/70 p-6 font-mono text-xs sm:text-sm leading-[1.75] text-white/90 shadow-2xl"
            tabindex="0"
            data-code
          ><code set:html={esc(t.code)} /></pre>
          <button
            type="button"
            class="absolute top-4 right-4 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 font-mono text-xs text-white/80 transition-all duration-200 hover:border-white hover:bg-white hover:text-black active:scale-95"
            data-copy
            aria-label={`Copy ${t.label} snippet`}
          >Copy</button>
        </div>
      ))}
    </div>

    <div class="mt-4 flex items-center gap-2 font-mono text-xs text-white/40">
      <span class="h-1.5 w-1.5 rounded-full bg-white"></span>
      <span>Takes ~3 minutes · Zero account or API key needed</span>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-tabs]');
  if (root) {
    const tabs = [...root.querySelectorAll('[role=tab]')];
    const panels = [...root.querySelectorAll('[role=tabpanel]')];
    const select = (i: number) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
        t.className =
          'rounded-full px-5 py-2 text-xs font-semibold tracking-tight transition-all duration-200 ' +
          (i === j
            ? 'bg-white text-black shadow-[0_2px_12px_rgba(255,255,255,0.2)]'
            : 'text-white/60 hover:text-white');
      });
      panels.forEach((p, j) => (p.hidden = i !== j));
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));
    root.querySelector('[role=tablist]')?.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      const cur = tabs.findIndex((t) => t === document.activeElement);
      if (k === 'ArrowRight') select((cur + 1) % tabs.length);
      if (k === 'ArrowLeft') select((cur - 1 + tabs.length) % tabs.length);
    });
  }
</script>
