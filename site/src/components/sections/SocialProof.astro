---
const quotes: [string, string][] = [
  ['Caught a hallucinated package my agent added at 2 a.m. It had an install script that curled a remote binary.', 'Beta user · solo founder, 2 public repos'],
  ['The PR comment reads like a senior staff reviewer, not a noisy linter. My team actually reads it.', 'Beta user · staff engineer, team of 12'],
  ['1.2 seconds on our median PR. The first automated security check nobody asked to skip in CI.', 'Beta user · OSS maintainer, 4.1k stars'],
];
---

<section class="border-y border-white/10 relative bg-black/40" aria-label="Early feedback">
  <div class="wrap py-14">
    <div class="text-center" data-reveal>
      <p class="font-mono text-xs uppercase tracking-widest text-white/50">
        Compatible with every major agent · Cursor · Copilot · Claude Code · Windsurf · Aider
      </p>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {quotes.map(([q, who], i) => (
        <figure
          data-reveal
          style={`--reveal-delay: ${i * 70}ms`}
          class="card rounded-2xl p-6 sm:p-7 border border-white/10 bg-gradient-to-b from-[#0c0c10] to-[#040406]"
        >
          <blockquote class="text-[14.5px] leading-relaxed text-white/80">“{q}”</blockquote>
          <figcaption class="mt-4 flex items-center gap-2 font-mono text-xs text-white/40 border-t border-white/5 pt-3">
            <span class="h-1.5 w-1.5 rounded-full bg-white/60"></span>
            <span>{who}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
